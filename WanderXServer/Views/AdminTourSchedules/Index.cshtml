@model TourScheduleIndexViewModel
@{
    ViewData["Title"] = "Tour Schedule Management";
}

<div class="d-flex flex-column flex-xl-row justify-content-between gap-3 mb-4">
    <div>
        <div class="text-uppercase small fw-bold text-secondary">Admin</div>
        <h1 class="h2 mb-1">Tour Schedule Management</h1>
        <p class="text-secondary mb-0">Filter, reorder, and manage itinerary items by tour and date.</p>
    </div>
    <div class="d-flex align-items-start">
        <a class="btn btn-danger rounded-pill px-4" asp-action="Create">Add schedule</a>
    </div>
</div>

<section class="admin-card bg-white p-3 p-lg-4 mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-4 col-xl-3">
            <label asp-for="Filter.TourId" class="form-label fw-semibold">Tour</label>
            <select asp-for="Filter.TourId" asp-items="Model.Filter.Tours" class="form-select" name="TourId">
                <option value="">All tours</option>
            </select>
        </div>
        <div class="col-md-4 col-xl-3">
            <label asp-for="Filter.FilterDate" class="form-label fw-semibold">Date</label>
            <input asp-for="Filter.FilterDate" class="form-control" type="date" name="FilterDate" />
        </div>
        <div class="col-md-2 col-xl-2">
            <label asp-for="Filter.Month" class="form-label fw-semibold">Month</label>
            <input asp-for="Filter.Month" class="form-control" type="number" min="1" max="12" name="Month" />
        </div>
        <div class="col-md-2 col-xl-2">
            <label asp-for="Filter.Year" class="form-label fw-semibold">Year</label>
            <input asp-for="Filter.Year" class="form-control" type="number" min="2000" max="2100" name="Year" />
        </div>
        <div class="col-md-12 col-xl-2 d-flex gap-2">
            <button class="btn btn-dark flex-fill" type="submit">Filter</button>
            <a class="btn btn-outline-secondary flex-fill" asp-action="Index">Reset</a>
        </div>
    </form>
</section>

<section class="admin-card bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Day</th>
                    <th>Date</th>
                    <th>Tour day</th>
                    <th>Title</th>
                    <th>Location</th>
                    <th>Time</th>
                    <th>Sort</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Schedules.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-secondary py-5">No schedules match the current filters.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Schedules)
                    {
                        <tr>
                            <td><span class="badge text-bg-light border">@item.DayOfWeek</span></td>
                            <td>
                                <div class="schedule-day text-center px-2 py-1">
                                    <div class="fw-bold">@item.ScheduleDate.ToString("dd")</div>
                                    <div class="small">@item.ScheduleDate.ToString("MM/yyyy")</div>
                                </div>
                            </td>
                            <td>Day @item.DayNumber</td>
                            <td>
                                <div class="fw-bold">@item.Title</div>
                                <div class="small text-secondary">@item.TourName</div>
                            </td>
                            <td>@item.Location</td>
                            <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                            <td>@item.SortOrder</td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                                    <form asp-action="MoveUp" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-secondary" type="submit" title="Move up">Up</button>
                                    </form>
                                    <form asp-action="MoveDown" asp-route-id="@item.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-secondary" type="submit" title="Move down">Down</button>
                                    </form>
                                    <a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@item.Id">Details</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
