<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - WanderX Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: #f8fafc; color: #0f172a; }
        .admin-shell { min-height: 100vh; }
        .admin-sidebar {
            width: 260px;
            background: #f1f5f9;
            border-right: 1px solid #e2e8f0;
        }
        .admin-link {
            color: #64748b;
            border-radius: .75rem;
            font-weight: 700;
        }
        .admin-link:hover,
        .admin-link.active {
            color: #fff;
            background: #1e293b;
        }
        .admin-card {
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .04);
        }
        .table thead th {
            color: #64748b;
            font-size: .76rem;
            text-transform: uppercase;
            letter-spacing: .03em;
        }
        .schedule-day {
            width: 72px;
            border-radius: .75rem;
            background: #fff1f2;
            color: #ff5a5f;
        }
        @@media (max-width: 991.98px) {
            .admin-shell { display: block !important; }
            .admin-sidebar { width: 100%; border-right: 0; border-bottom: 1px solid #e2e8f0; }
        }
    </style>
</head>
<body>
    <div class="admin-shell d-flex">
        <aside class="admin-sidebar p-3 p-lg-4">
            <a class="d-inline-block mb-1 fs-4 fw-bold text-decoration-none text-dark" href="/admin/tour-schedules">WanderX</a>
            <div class="text-uppercase small fw-bold text-secondary mb-4">Admin Suite</div>
            <nav class="nav flex-column gap-2">
                <a class="admin-link active nav-link" asp-controller="AdminTourSchedules" asp-action="Index">Tour Schedules</a>
                <a class="admin-link nav-link" href="/swagger">API Swagger</a>
            </nav>
        </aside>
        <main class="flex-fill">
            <div class="container-fluid p-3 p-lg-4">
                @if (TempData["SuccessMessage"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @success
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
