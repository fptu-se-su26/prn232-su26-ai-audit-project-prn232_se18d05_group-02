@inject AuthSessionService AuthSession

<section class="section">
    <div class="wx-container quiz-band">
        <div>
            <span class="section__eyebrow">
                <MaterialIcon Name="psychology" />
                AI-Powered Matching
            </span>
            <h2 class="mt-3">Not sure where to start?</h2>
            <p class="mt-3">Take a quick travel style quiz and get curated itineraries that match your pace, budget, and kind of adventure.</p>
        </div>
        @if (_isLoggedIn)
        {
            <a class="wx-button wx-button--secondary" href="/travel-quiz">
                Take the Quiz
                <MaterialIcon Name="arrow_forward" />
            </a>
        }
        else
        {
            <a class="wx-button wx-button--secondary" href="/login?returnUrl=/travel-quiz">
                Take the Quiz
                <MaterialIcon Name="arrow_forward" />
            </a>
        }
    </div>
</section>

@code {
    private bool _isLoggedIn;

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthSession.GetAsync();
        _isLoggedIn = session != null;
    }
}
