                                        'muted-fg': '#64748b', 'accent-orange': '#ff5a5f',
                                        'on-accent-orange': '#ffffff', 'accent-orange-soft': '#fff1f2'
                                    },
                                    fontFamily: {
                                        title: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
                                        body: ['Inter', 'sans-serif']
                                    }
                                }
                            }
                        };
                    };
                    document.head.appendChild(script);
                })();
            ");
        }
    }
