@page "/booking-detail/{Id:guid}"
@using WanderXClient.Models
@using WanderXClient.Services
@inject UserApiClient UserApi
@inject AuthSessionService SessionService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

<PageTitle>WanderX - Booking Details @(_booking?.BookingCode ?? "")</PageTitle>

<AppHeader />

@if (_isLoading)
{
    <div class="flex justify-center items-center min-h-[60vh]">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 !border-primary"></div>
    </div>
}
else if (_booking == null)
{
    <main class="flex-grow max-w-7xl w-full mx-auto px-6 py-24 text-center">
        <span class="material-symbols-outlined text-5xl text-muted-fg">error_outline</span>
        <h2 class="font-title font-bold text-xl !text-primary mt-4">Booking not found</h2>
        <a href="/my-bookings" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold !text-primary hover:underline">
            <span class="material-symbols-outlined text-base">arrow_back</span> Back to list
        </a>
    </main>
}
else
{
    var cancellationPending = string.Equals(_booking.CancellationStatus, "Pending", StringComparison.OrdinalIgnoreCase);
    var cancellationRejected = string.Equals(_booking.CancellationStatus, "Rejected", StringComparison.OrdinalIgnoreCase);
    var canRequestCancellation = _booking.Status != "Cancelled"
        && _booking.Status != "Finished"
        && !_booking.PaidAt.HasValue
        && !cancellationPending;

    var statusStyles = _booking.Status switch
    {
        "Paid"      => "bg-green-100 text-green-700",
        "Pending"   => "bg-amber-100 text-amber-700",
        "Cancelled" => "bg-red-100 text-red-700",
        _           => "bg-gray-100 text-gray-700"
    };
    var statusText = _booking.Status switch
    {
        "Paid"      => "Paid",
        "Pending"   => "Pending payment",
        "Cancelled" => "Cancelled",
        _           => _booking.Status
    };

    <main class="flex-grow max-w-7xl w-full mx-auto px-6 py-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">

            <aside class="lg:col-span-4 bg-white border border-hairline rounded-lg p-6 space-y-6 shadow-sm">
                <div class="flex flex-col items-center text-center pb-6 border-b border-hairline">
                    <div class="w-20 h-20 rounded-full overflow-hidden border-2 !border-primary mb-4">
                        <img alt="User Avatar" class="w-full h-full object-cover" src="@_avatarUrl">
                    </div>
                    <h3 class="font-title font-bold text-lg !text-primary">@_session?.FullName</h3>
                    <span class="text-xs font-semibold text-muted-fg">@_session?.Email</span>
                   
                </div>
                <nav class="flex flex-col gap-1 text-sm font-semibold text-muted-fg">
                    <a href="my-bookings" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-surface-soft !text-primary">
                        <span class="material-symbols-outlined text-lg">receipt_long</span>
                        My Bookings
                    </a>
                    <a href="service-requests" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-surface-soft hover:!text-primary transition-colors">
                        <span class="material-symbols-outlined text-lg">description</span>
                        Service Requests
                    </a>
                    <a href="profile" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-surface-soft hover:!text-primary transition-colors">
                        <span class="material-symbols-outlined text-lg">person</span>
                        Profile
                    </a>
                    <a href="travel-quiz" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-surface-soft hover:!text-primary transition-colors">
                        <span class="material-symbols-outlined text-lg">quiz</span>
                        Travel Style Quiz
                    </a>
                </nav>
            </aside>

            <section class="lg:col-span-8 space-y-8">

                <!-- Back + Header -->
                <div class="space-y-4">
                    <a href="/my-bookings" class="flex items-center gap-2 text-xs font-bold text-muted-fg hover:!text-primary transition-colors uppercase tracking-wider">
                        <span class="material-symbols-outlined text-base">arrow_back</span> Back to bookings
                    </a>
                    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-hairline pb-4">
                        <div>
                            <span class="text-xs text-muted-fg font-semibold">Booking code: <span class="!text-primary font-bold">@_booking.BookingCode</span></span>
                            <h1 class="text-2xl font-extrabold tracking-tight font-title !text-primary mt-1">@_booking.TourName</h1>
                            <span class="px-3 py-1 rounded text-xs font-bold @statusStyles inline-block mt-2">@statusText</span>
                            @if (cancellationPending)
                            {
                                <span class="ml-2 px-3 py-1 rounded text-xs font-bold bg-blue-100 text-blue-700 inline-block mt-2">Cancellation pending</span>
                            }
                            else if (cancellationRejected)
                            {
                                <span class="ml-2 px-3 py-1 rounded text-xs font-bold bg-slate-100 text-slate-700 inline-block mt-2">Cancellation rejected</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="bg-white border border-hairline rounded-lg p-6 md:p-8 space-y-6 shadow-sm">
                    <div class="flex justify-between items-center">
                        <h3 class="font-title font-bold text-base !text-primary">Booking Progress</h3>
                        <div class="flex gap-2">
                            @if (!_booking.PaidAt.HasValue)
                            {
                                <button class="wx-button wx-button--secondary text-sm px-4 py-2" @onclick="ShowSpecialRequestModal">
                                    <span class="material-symbols-outlined text-lg mr-1">add</span>
                                    Add request
                                </button>
                            }
                            @if (_booking.CompletedAt.HasValue)
                            {
                                <button class="wx-button wx-button--secondary text-sm px-4 py-2" @onclick="NavigateToReview">
                                    <span class="material-symbols-outlined text-lg mr-1">star</span>
                                    Tour Reviews
                                </button>
                            }
                        </div>
                    </div>

                    @{
                        // Resolve each progress step state.
                        bool step1Done = _booking.ApprovedAt.HasValue;
                        bool step1Failed = _booking.RequestFailedAt.HasValue;
                        bool step2Done = _booking.PaidAt.HasValue;
                        bool step2Failed = _booking.PaymentFailedAt.HasValue;
                        bool step3Done = _booking.ConfirmedAt.HasValue;
                        bool step3Failed = _booking.ConfirmationFailedAt.HasValue;
                        bool step4Done = _booking.CompletedAt.HasValue;
                        bool step4Failed = _booking.CompletionFailedAt.HasValue;
                        bool isCancelled = _booking.Status == "Cancelled";

                        bool step1Spin = !step1Done && !step1Failed && !isCancelled;
                        bool step2Spin = step1Done && !step2Done && !step2Failed && !isCancelled;
                        bool step3Spin = step2Done && !step3Done && !step3Failed && !isCancelled;
                        bool step4Spin = step3Done && !step4Done && !step4Failed && !isCancelled;

                        bool canShowCancel = isCancelled && !_booking.PaidAt.HasValue;
                    }

                    <div class="relative pl-6 border-l-4 border-blue-500 ml-3 space-y-8 text-sm">

                        <div class="relative z-10">
                            @if (canShowCancel || step1Failed)
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-red-500 flex items-center justify-center text-white border-2 border-white shadow-sm z-20">
                                    <span class="material-symbols-outlined text-[10px] font-bold">close</span>
                                </span>
                            }
                            else if (step1Done)
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-green-500 flex items-center justify-center text-white border-2 border-white shadow-sm z-20">
                                    <span class="material-symbols-outlined text-[10px] font-bold">check</span>
                                </span>
                            }
                            else if (step1Spin)
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full border-2 border-amber-400 flex items-center justify-center shadow-sm animate-spin border-b-transparent z-20"></span>
                            }
                            else
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-white border-2 border-gray-300 flex items-center justify-center shadow-sm z-20">
                                    <span class="material-symbols-outlined text-[10px] text-gray-400">circle</span>
                                </span>
                            }
                            <div>
                                <h4 class="font-semibold !text-primary">Booking request</h4>
                                @if (canShowCancel || step1Failed)
                                {
                                    <span class="text-xs text-muted-fg">@(canShowCancel ? "Cancelled" : "Rejected")</span>
                                }
                                else if (step1Done)
                                {
                                    <span class="text-xs text-muted-fg">@_booking.ApprovedAt!.Value.ToLocalTime().ToString("dd/MM/yyyy - HH:mm")</span>
                                }
                                else if (step1Spin)
                                {
                                    <span class="text-xs text-muted-fg">Processing</span>
                                }
                                
                            </div>
                        </div>

                        <!-- Step 2: Payment -->
                        <div class="relative z-10">
                            @if (canShowCancel || step2Failed)
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-red-500 flex items-center justify-center text-white border-2 border-white shadow-sm z-20">
                                    <span class="material-symbols-outlined text-[10px] font-bold">close</span>
                                </span>
                            }
                            else if (step2Done)
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-green-500 flex items-center justify-center text-white border-2 border-white shadow-sm z-20">
                                    <span class="material-symbols-outlined text-[10px] font-bold">check</span>
                                </span>
                            }
                            else if (step2Spin)
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full border-2 border-amber-400 flex items-center justify-center shadow-sm animate-spin border-b-transparent z-20"></span>
                            }
                            else
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-white border-2 border-gray-300 flex items-center justify-center shadow-sm z-20">
                                    <span class="material-symbols-outlined text-[10px] text-gray-400">circle</span>
                                </span>
                            }

                            <div>
                                <h4 class="font-semibold !text-primary">Payment (@_booking.TotalAmount.ToString("N0") VND)</h4>
                                @if (canShowCancel || step2Failed)
                                {
                                    <span class="text-xs text-muted-fg">@(canShowCancel ? "Cancelled" : "Failed")</span>
                                }
                                else if (step2Done)
                                {
                                    <span class="text-xs text-muted-fg">@_booking.PaidAt!.Value.ToLocalTime().ToString("dd/MM/yyyy - HH:mm")</span>
                                }
                                else if (step2Spin)
                                {
                                    <span class="text-xs text-muted-fg">Processing</span>
                                }
                                
                            </div>
                        </div>

                        <div class="relative z-10">
                            @if (step3Failed)
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-red-500 flex items-center justify-center text-white border-2 border-white shadow-sm z-20">
                                    <span class="material-symbols-outlined text-[10px] font-bold">close</span>
                                </span>
                            }
                            else if (step3Done)
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-green-500 flex items-center justify-center text-white border-2 border-white shadow-sm z-20">
                                    <span class="material-symbols-outlined text-[10px] font-bold">check</span>
                                </span>
                            }
                            else if (step3Spin)
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full border-2 border-amber-400 flex items-center justify-center shadow-sm animate-spin border-b-transparent z-20"></span>
                            }
                            else
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-white border-2 border-gray-300 flex items-center justify-center shadow-sm z-20">
                                    <span class="material-symbols-outlined text-[10px] text-gray-400">circle</span>
                                </span>
                            }

                            <div>
                                <h4 class="font-semibold !text-primary">Staff confirmation</h4>
                                @if (step3Failed)
                                {
                                    <span class="text-xs text-muted-fg">Rejected</span>
                                }
                                else if (step3Done)
                                {
                                    <span class="text-xs text-muted-fg">@_booking.ConfirmedAt!.Value.ToLocalTime().ToString("dd/MM/yyyy - HH:mm")</span>
                                }
                                else if (step3Spin)
                                {
                                    <span class="text-xs text-muted-fg">Processing</span>
                                }
                                
                            </div>
                        </div>

                        <div class="relative z-10">
                            @if (step4Failed)
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-red-500 flex items-center justify-center text-white border-2 border-white shadow-sm z-20">
                                    <span class="material-symbols-outlined text-[10px] font-bold">close</span>
                                </span>
                            }
                            else if (step4Done)
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-green-500 flex items-center justify-center text-white border-2 border-white shadow-sm z-20">
                                    <span class="material-symbols-outlined text-[10px] font-bold">check</span>
                                </span>
                            }
                            else if (step4Spin)
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full border-2 border-amber-400 flex items-center justify-center shadow-sm animate-spin border-b-transparent z-20"></span>
                            }
                            else
                            {
                                <span class="absolute -left-[31px] top-0.5 w-4 h-4 rounded-full bg-white border-2 border-gray-300 flex items-center justify-center shadow-sm z-20">
                                    <span class="material-symbols-outlined text-[10px] text-gray-400">circle</span>
                                </span>
                            }

                            <div>
                                <h4 class="font-semibold !text-primary">Trip</h4>
                                @if (step4Failed)
                                {
                                    <span class="text-xs text-muted-fg">Tour cancelled</span>
                                }
                                else if (step4Done)
                                {
                                    <span class="text-xs text-muted-fg">Get ready for departure</span>
                                }
                                else if (step4Spin)
                                {
                                    <span class="text-xs text-muted-fg">Processing</span>
                                }
                                
                            </div>
                        </div>

                    </div>
                </div>

                <div class="bg-white border border-hairline rounded-lg p-6 md:p-8 space-y-4">
                    <h3 class="font-title font-bold text-base !text-primary">Passenger List</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left border-collapse">
                            <thead>
                                <tr class="border-b border-hairline text-xs font-bold text-muted-fg uppercase tracking-wider">
                                    <th class="py-3 px-4">Passenger Name</th>
                                    <th class="py-3 px-4">Phone Number</th>
                                    <th class="py-3 px-4">Ticket Type</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-hairline">
                                @if (_booking.Passengers != null && _booking.Passengers.Any())
                                {
                                    foreach (var passenger in _booking.Passengers)
                                    {
                                        <tr class="font-medium !text-primary">
                                            <td class="py-3.5 px-4">@passenger.FullName</td>
                                            <td class="py-3.5 px-4">@passenger.PhoneNumber</td>
                                            <td class="py-3.5 px-4">@passenger.TicketType</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    @for (int i = 1; i <= _booking.GuestCount; i++)
                                    {
                                        var rowIndex = i;
                                        <tr class="font-medium !text-primary">
                                            <td class="py-3.5 px-4">PASSENGER @rowIndex</td>
                                            <td class="py-3.5 px-4">Updating</td>
                                            <td class="py-3.5 px-4">Adult @(rowIndex == 1 ? "(Group leader)" : "")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (_booking.Status != "Cancelled")
                {
                    <div class="bg-white border border-hairline rounded-lg p-6 md:p-8 flex flex-col md:flex-row justify-between items-center gap-6">
                        <div class="space-y-1 text-center md:text-left">
                            <span class="text-xs font-semibold text-muted-fg uppercase tracking-wider">VAT invoice</span>
                            <h4 class="font-title font-bold text-lg !text-primary">VAT Invoice & Receipts</h4>
                            <p class="text-xs text-muted-fg">Download the official electronic invoice for this booking.</p>
                        </div>
                        <div class="flex gap-3">
                            @if (_booking.PaidAt.HasValue)
                            {
                                <button class="bg-primary hover:bg-primary/95 text-white font-semibold text-sm px-6 py-3 rounded-full transition-all shadow-sm flex items-center gap-2">
                                    <span class="material-symbols-outlined text-lg">download</span>
                                    Export Invoice
                                </button>
                            }
                            @if (canRequestCancellation)
                            {
                                <button class="border border-hairline hover:bg-surface-soft !text-primary font-semibold text-sm px-6 py-3 rounded-full transition-all flex items-center gap-2" @onclick="ShowCancelModal">
                                    Cancellation Request
                                </button>
                            }
                        </div>
                    </div>
                }

            </section>
        </div>
    </main>
    <AppFooter />

    @if (_showCancelModal)
    {
        <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
            <div class="bg-white rounded-lg shadow-xl max-w-lg w-full p-6 space-y-4">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-3xl text-amber-500">assignment_late</span>
                    <h3 class="text-xl font-bold !text-primary">Request booking cancellation</h3>
                </div>
                <p class="text-sm text-muted-fg">
                    Your request for booking <span class="font-semibold !text-primary">@_booking?.BookingCode</span> will be reviewed by WanderX staff before the booking is cancelled.
                </p>
                <div class="space-y-2">
                    <label class="text-sm font-semibold !text-primary">Reason</label>
                    <textarea class="w-full border border-hairline rounded-lg p-3 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-primary/15"
                              rows="4"
                              maxlength="1000"
                              @bind="_cancelReason"
                              placeholder="Tell us why you want to cancel this booking."></textarea>
                </div>
                @if (!string.IsNullOrWhiteSpace(_cancelError))
                {
                    <div class="bg-red-50 border border-red-200 rounded-lg p-3">
                        <p class="text-xs text-red-700">@_cancelError</p>
                    </div>
                }
                <div class="flex gap-3 justify-end pt-2">
                    <button class="px-4 py-2 rounded-lg border border-hairline hover:bg-surface-soft text-sm font-semibold !text-primary transition-colors" @onclick="HideCancelModal">
                        Keep booking
                    </button>
                    <button class="px-4 py-2 rounded-lg bg-red-500 hover:bg-red-600 text-white text-sm font-semibold transition-colors flex items-center gap-2" @onclick="ConfirmCancel" disabled="@_isCancelling">
                        @if (_isCancelling)
                        {
                            <span class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></span>
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>Send request</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_showSpecialRequestModal)
    {
        <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
            <div class="bg-white rounded-lg max-w-lg w-full p-6 space-y-4">
                <div class="flex justify-between items-center">
                    <h3 class="font-title font-bold text-lg !text-primary">Add Special Requests</h3>
                    <button @onclick="HideSpecialRequestModal" class="text-muted-fg hover:!text-primary">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>

                <div class="space-y-2">
                    <label class="text-sm font-semibold !text-primary">Description</label>
                    <p class="text-xs text-muted-fg">Enter one or more requests:</p>
                    <p class="text-xs text-muted-fg italic">Request 1: ...</p>
                    <p class="text-xs text-muted-fg italic">Request n: ...</p>
                    <textarea class="w-full border border-hairline rounded-lg p-3 text-sm resize-none" rows="4" @bind="_specialRequestDescription" placeholder="Enter your requests..."></textarea>
                </div>

                <div class="bg-amber-50 border border-amber-200 rounded-lg p-3">
                    <p class="text-xs text-amber-800">
                        <strong>Note:</strong> Additional requests can only be submitted during steps 1-2. After payment is completed, you cannot add more requests. Extra services may increase trip costs depending on the case.
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(_specialRequestError))
                {
                    <div class="bg-red-50 border border-red-200 rounded-lg p-3">
                        <p class="text-xs text-red-700">@_specialRequestError</p>
                    </div>
                }

                <div class="flex gap-3 justify-end">
                    <button class="wx-button wx-button--outline" @onclick="HideSpecialRequestModal" disabled="@_isSubmittingRequest">
                        Cancel
                    </button>
                    <button class="wx-button wx-button--secondary" @onclick="SubmitSpecialRequest" disabled="@_isSubmittingRequest">
                        @if (_isSubmittingRequest)
                        {
                            <span class="animate-spin rounded-full h-4 w-4 border-b-2 border-white inline-block mr-2"></span>
                            <span>Submitting...</span>
                        }
                        else
                        {
                            <span>Submit</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _isLoading = true;
    private bool _showCancelModal = false;
    private bool _isCancelling = false;
    private string _cancelReason = string.Empty;
    private string _cancelError = string.Empty;
    private bool _showSpecialRequestModal = false;
    private bool _isSubmittingRequest = false;
    private string _specialRequestDescription = string.Empty;
    private string _specialRequestError = string.Empty;
    private AuthSession? _session;
    private BookingSummaryResponse? _booking;
    private string _avatarUrl = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=200";


    protected override async Task OnInitializedAsync()
    {
        _session = await SessionService.GetAsync();
        if (_session == null)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        try
        {
            var savedAvatar = await JSRuntime.InvokeAsync<string>("localStorage.getItem", $"avatar_{_session.Email}");
            if (!string.IsNullOrEmpty(savedAvatar))
            {
                _avatarUrl = savedAvatar;
            }

            _booking = await UserApi.GetBookingByIdAsync(Id);
        }
        catch (Exception)
        {
            _booking = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowCancelModal()
    {
        _cancelError = string.Empty;
        _showCancelModal = true;
    }

    private void HideCancelModal()
    {
        _showCancelModal = false;
        _cancelReason = string.Empty;
        _cancelError = string.Empty;
    }

    private void ShowSpecialRequestModal()
    {
        _specialRequestError = string.Empty;
        _showSpecialRequestModal = true;
    }

    private void HideSpecialRequestModal()
    {
        _showSpecialRequestModal = false;
        _specialRequestDescription = string.Empty;
        _specialRequestError = string.Empty;
    }

    private void NavigateToReview()
    {
        if (_booking == null) return;
        NavManager.NavigateTo($"/tour-review/{_booking.Id}");
    }

    private async Task SubmitSpecialRequest()
    {
        if (_booking == null || string.IsNullOrWhiteSpace(_specialRequestDescription))
        {
            _specialRequestError = "Please enter a request description.";
            return;
        }

        if (_specialRequestDescription.Trim().Length < 10)
        {
            _specialRequestError = "The request description must be at least 10 characters.";
            return;
        }

        _isSubmittingRequest = true;
        _specialRequestError = string.Empty;
        try
        {
            var request = new CreateUserSpecialRequestRequest
            {
                BookingId = _booking.Id,
                Description = _specialRequestDescription.Trim()
            };

            await UserApi.CreateSpecialRequestAsync(request);

            HideSpecialRequestModal();
            NavManager.NavigateTo("/service-requests");
        }
        catch (Exception ex)
        {
            _specialRequestError = ex.Message.Contains("404")
                ? "API endpoint was not found. Please restart WanderXServer and try again."
                : ex.Message;
        }
        finally
        {
            _isSubmittingRequest = false;
        }
    }

    private async Task ConfirmCancel()
    {
        if (_booking == null) return;

        if (string.IsNullOrWhiteSpace(_cancelReason) || _cancelReason.Trim().Length < 10)
        {
            _cancelError = "Please enter a cancellation reason with at least 10 characters.";
            return;
        }

        _isCancelling = true;
        _cancelError = string.Empty;
        try
        {
            var updatedBooking = await UserApi.CancelBookingAsync(_booking.Id, new CreateCancellationRequest
            {
                Reason = _cancelReason.Trim()
            });
            if (updatedBooking != null)
            {
                _booking = updatedBooking;
            }
            HideCancelModal();
        }
        catch (Exception ex)
        {
            _cancelError = ex.Message;
        }
        finally
        {
            _isCancelling = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                (function() {
                    if (document.getElementById('tailwind-cdn')) return;
                    var script = document.createElement('script');
                    script.id = 'tailwind-cdn';
                    script.src = 'https://cdn.tailwindcss.com?plugins=forms,container-queries';
                    script.onload = function() {
                        tailwind.config = {
                            corePlugins: { preflight: false },
                            darkMode: 'class',
                            theme: {
                                extend: {
                                    colors: {
                                        primary: '#0f172a', 'on-primary': '#ffffff', canvas: '#ffffff',
                                        'surface-soft': '#f8fafc', 'surface-mid': '#f1f5f9', hairline: '#e2e8f0',
                                        'muted-fg': '#64748b', 'accent-orange': '#ff5a5f',
                                        'on-accent-orange': '#ffffff', 'accent-orange-soft': '#fff1f2'
                                    },
                                    fontFamily: {
                                        title: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
                                        body: ['Inter', 'sans-serif']
                                    }
                                }
                            }
                        };
                    };
                    document.head.appendChild(script);
                })();
            ");
        }
    }
}
