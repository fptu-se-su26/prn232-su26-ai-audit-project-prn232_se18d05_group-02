@code {
    private const int PageSize = 5;
    private readonly string[] _statusFilters = ["All", "Pending", "Approved", "Rejected"];
    private readonly List<BookingResponse> _requests = new();
    private bool _isLoading = true;
    private bool _isReviewing;
    private string _statusFilter = "All";
    private string _searchTerm = string.Empty;
    private string _message = string.Empty;
    private string _error = string.Empty;
    private string _reviewError = string.Empty;
    private string _reviewStatus = "Approved";
    private string _reviewNote = string.Empty;
    private string _reviewedBy = "Admin staff";
    private int _currentPage = 1;
    private BookingResponse? _selectedRequest;

    private IEnumerable<BookingResponse> FilteredRequests
    {
        get
        {
            var query = _requests.AsEnumerable();

            if (_statusFilter != "All")
            {
                query = query.Where(item => string.Equals(item.CancellationStatus, _statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(item =>
                    item.BookingCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    item.TourName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    item.Destination.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (item.TourCode?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    item.CustomerName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    item.CustomerEmail.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    private int FilteredCount => FilteredRequests.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)PageSize));
    private int PageStart => FilteredCount == 0 ? 0 : ((_currentPage - 1) * PageSize) + 1;
    private int PageEnd => Math.Min(_currentPage * PageSize, FilteredCount);
    private IEnumerable<BookingResponse> PagedRequests => FilteredRequests.Skip((_currentPage - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        var session = await SessionService.GetAsync();
        _reviewedBy = string.IsNullOrWhiteSpace(session?.FullName)
            ? session?.Email ?? "Admin staff"
            : session.FullName;

        await LoadRequestsAsync();
    }

    private async Task LoadRequestsAsync()
    {
        _isLoading = true;
        _error = string.Empty;

        try
        {
            var requests = await UserApi.GetCancellationRequestsAsync();
            _requests.Clear();
            if (requests is not null)
            {
                _requests.AddRange(requests);
            }
            ClampPage();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        _searchTerm = args.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
    }

    private void SetStatusFilter(string status)
    {
        _statusFilter = status;
        _currentPage = 1;
    }

    private void SetPage(int page)
    {
        _currentPage = Math.Clamp(page, 1, TotalPages);
    }

    private void PreviousPage()
    {
        SetPage(_currentPage - 1);
    }

    private void NextPage()
    {
        SetPage(_currentPage + 1);
    }

    private void ClampPage()
    {
        _currentPage = Math.Clamp(_currentPage, 1, TotalPages);
    }

    private void OpenReviewModal(BookingResponse request)
    {
        _selectedRequest = request;
        _reviewStatus = "Approved";
        _reviewNote = string.Empty;
        _reviewError = string.Empty;
        _message = string.Empty;
    }

    private void CloseReviewModal()
    {
        if (_isReviewing)
        {
            return;
        }

        _selectedRequest = null;
        _reviewError = string.Empty;
    }

    private async Task SubmitReviewAsync()
    {
        if (_selectedRequest is null)
        {
            return;
        }

        _isReviewing = true;
        _reviewError = string.Empty;
        _message = string.Empty;

        try
        {
            var updated = await UserApi.ReviewCancellationRequestAsync(_selectedRequest.Id, new ReviewCancellationRequest
            {
                Status = _reviewStatus,
                ReviewedBy = _reviewedBy,
                ReviewNote = string.IsNullOrWhiteSpace(_reviewNote) ? null : _reviewNote.Trim()
            });

            if (updated is not null)
            {
                var index = _requests.FindIndex(item => item.Id == updated.Id);
                if (index >= 0)
                {
                    _requests[index] = updated;
                }
            }

            _message = _reviewStatus == "Approved"
                ? "Cancellation request approved. The booking has been cancelled."
                : "Cancellation request rejected. The booking status was kept unchanged.";
            _selectedRequest = null;
        }
        catch (Exception ex)
        {
            _reviewError = ex.Message;
        }
        finally
        {
            _isReviewing = false;
        }
    }

    private static string GetCancellationStatus(BookingResponse request)
    {
        return string.IsNullOrWhiteSpace(request.CancellationStatus) ? "Pending" : request.CancellationStatus;
    }

    private static string GetCancellationClass(string? status)
    {
        return status switch
        {
            "Approved" => "cancel-pill cancel-pill--approved",
            "Rejected" => "cancel-pill cancel-pill--rejected",
            _ => "cancel-pill cancel-pill--pending"
        };
    }

    private static string GetBookingStatusClass(string status)
    {
        return status switch
        {
            "Cancelled" => "booking-pill booking-pill--cancelled",
            "Confirmed" or "Finished" or "Paid" => "booking-pill booking-pill--active",
            _ => "booking-pill"
        };
    }

    private static string GetReviewTitle(BookingResponse request)
    {
        return string.Equals(request.CancellationStatus, "Pending", StringComparison.OrdinalIgnoreCase)
            ? "Review request"
            : "View decision";
    }

    private static string FormatDateTime(DateTime? value)
    {
        return value.HasValue ? value.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Not recorded";
    }
}
