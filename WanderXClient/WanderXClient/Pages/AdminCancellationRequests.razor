@page "/admin-cancellations"
@using System.Globalization
@using WanderXClient.Models
@using WanderXClient.Services
@inject UserApiClient UserApi
@inject AuthSessionService SessionService

<PageTitle>WanderX Admin - Cancellation Requests</PageTitle>

<div class="guide-admin-page">
    <aside class="guide-sidebar">
        <div class="guide-sidebar__brand">
            <a class="brand-mark" href="/">WanderX</a>
            <p>Admin Suite</p>
        </div>
        <nav class="guide-sidebar__nav" aria-label="Admin navigation">
            <a class="guide-sidebar__link" href="/dashboard">
                <MaterialIcon Name="dashboard" />
                Dashboard
            </a>
            <a class="guide-sidebar__link" href="/admin-bookings">
                <MaterialIcon Name="receipt_long" />
                Bookings
            </a>
            <a class="guide-sidebar__link guide-sidebar__link--active" href="/admin-cancellations" aria-current="page">
                <MaterialIcon Name="rule" />
                Cancel Requests
            </a>
            <a class="guide-sidebar__link" href="/admin-payments">
                <MaterialIcon Name="payments" />
                Payments
            </a>
            <a class="guide-sidebar__link" href="/guide-assignments">
                <MaterialIcon Name="assignment_ind" />
                Assignments
            </a>
            <a class="guide-sidebar__link" href="/admin-service-requests">
                <MaterialIcon Name="support_agent" />
                Service Requests
            </a>
            <a class="guide-sidebar__link" href="/tour-reviews">
                <MaterialIcon Name="rate_review" />
                Tour Reviews
            </a>
            <a class="guide-sidebar__link" href="/">
                <MaterialIcon Name="home" />
                Homepage
            </a>
        </nav>
    </aside>

    <main class="guide-main">
        <header class="guide-topbar">
            <div>
                <p class="guide-eyebrow">Member 2 / Feature 3</p>
                <h1>Cancellation Requests</h1>
                <p class="guide-subtitle">Review booking cancellation requests and approve or reject them with a staff note.</p>
            </div>
            <div class="guide-topbar__actions">
                <label class="guide-search" aria-label="Search cancellation requests">
                    <MaterialIcon Name="search" />
                    <input type="search" placeholder="Search booking, tour, customer..." value="@_searchTerm" @oninput="OnSearchInput" />
                </label>
            </div>
        </header>

        <section class="guide-content cancellation-page">
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="guide-alert">@_message</div>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="guide-alert guide-alert--error">@_error</div>
            }

            <div class="guide-stat-grid">
                <article class="guide-stat">
                    <p>Total requests</p>
                    <strong>@_requests.Count</strong>
                    <span>All cancellation records</span>
                </article>
                <article class="guide-stat guide-stat--secondary">
                    <p>Pending review</p>
                    <strong>@_requests.Count(item => item.CancellationStatus == "Pending")</strong>
                    <span>Waiting for staff action</span>
                </article>
                <article class="guide-stat guide-stat--tertiary">
                    <p>Approved</p>
                    <strong>@_requests.Count(item => item.CancellationStatus == "Approved")</strong>
                    <span>Bookings cancelled</span>
                </article>
                <article class="guide-stat">
                    <p>Rejected</p>
                    <strong>@_requests.Count(item => item.CancellationStatus == "Rejected")</strong>
                    <span>Bookings kept active</span>
                </article>
            </div>

            <section class="guide-table-shell cancellation-table-shell">
                <div class="guide-table-toolbar">
                    <div class="guide-filter-group" role="group" aria-label="Cancellation status filter">
                        @foreach (var status in _statusFilters)
                        {
                            <button class="@(_statusFilter == status ? "guide-filter guide-filter--active" : "guide-filter")"
                                    type="button"
                                    @onclick="() => SetStatusFilter(status)">
                                @status
                            </button>
                        }
                    </div>
                    <p>@FilteredCount requests</p>
                </div>

                @if (_isLoading)
                {
                    <div class="guide-empty">
                        <MaterialIcon Name="sync" />
                        Loading cancellation requests...
                    </div>
                }
                else if (FilteredCount == 0)
                {
                    <div class="guide-empty">
                        <MaterialIcon Name="inbox" />
                        No cancellation requests found.
                    </div>
                }
                else
                {
                    <div class="guide-table-scroll booking-table-scroll cancellation-table-scroll">
                        <table class="guide-table booking-table cancellation-table">
                            <colgroup>
                                <col class="cancellation-table__col-booking" />
                                <col class="cancellation-table__col-reason" />
                                <col class="cancellation-table__col-requested" />
                                <col class="cancellation-table__col-status" />
                                <col class="cancellation-table__col-actions" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Booking</th>
                                    <th>Reason</th>
                                    <th>Requested</th>
                                    <th>Status</th>
                                    <th class="guide-table__actions">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in PagedRequests)
                                {
                                    <tr>
                                        <td data-label="Booking">
                                            <div class="booking-cell-title">
                                                <strong>@request.TourName</strong>
                                                <span>@request.BookingCode · @(request.TourCode ?? "No tour code")</span>
                                                <span>@request.CustomerName · @request.CustomerEmail</span>
                                            </div>
                                        </td>
                                        <td data-label="Reason">
                                            <p class="cancellation-reason">@(string.IsNullOrWhiteSpace(request.CancellationReason) ? "No reason provided." : request.CancellationReason)</p>
                                        </td>
                                        <td data-label="Requested">
                                            <div class="booking-status-cell">
                                                <strong>@FormatDateTime(request.CancellationRequestedAt)</strong>
                                                <small>@request.TotalAmount.ToString("N0", CultureInfo.InvariantCulture) VND</small>
                                            </div>
                                        </td>
                                        <td data-label="Status">
                                            <div class="booking-status-cell">
                                                <span class="@GetCancellationClass(request.CancellationStatus)">
                                                    <span></span>@GetCancellationStatus(request)
                                                </span>
                                                <small>Booking: @request.Status</small>
                                            </div>
                                        </td>
                                        <td class="guide-table__actions" data-label="Actions">
                                            <button class="guide-icon-button"
                                                    type="button"
                                                    title="@GetReviewTitle(request)"
                                                    @onclick="() => OpenReviewModal(request)">
                                                <MaterialIcon Name="fact_check" />
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="booking-pagination">
                        <p>Showing @PageStart-@PageEnd of @FilteredCount</p>
                        <div class="booking-pagination__controls" role="navigation" aria-label="Cancellation request pages">
                            <button class="guide-icon-button"
                                    type="button"
                                    title="Previous page"
                                    disabled="@(_currentPage <= 1)"
                                    @onclick="PreviousPage">
                                <MaterialIcon Name="chevron_left" />
                            </button>

                            @foreach (var pageNumber in Enumerable.Range(1, TotalPages))
                            {
                                <button class="booking-page-button @(pageNumber == _currentPage ? "booking-page-button--active" : string.Empty)"
                                        type="button"
                                        aria-current="@(pageNumber == _currentPage ? "page" : null)"
                                        @onclick="() => SetPage(pageNumber)">
                                    @pageNumber
                                </button>
                            }

                            <button class="guide-icon-button"
                                    type="button"
                                    title="Next page"
                                    disabled="@(_currentPage >= TotalPages)"
                                    @onclick="NextPage">
                                <MaterialIcon Name="chevron_right" />
                            </button>
                        </div>
                    </div>
                }
            </section>
        </section>
    </main>

    <MobileBottomNav />
</div>

@if (_selectedRequest is not null)
{
    var readOnly = !string.Equals(_selectedRequest.CancellationStatus, "Pending", StringComparison.OrdinalIgnoreCase);

    <div class="booking-modal-overlay cancellation-modal-overlay" @onclick="CloseReviewModal">
        <section class="booking-modal cancellation-modal" role="dialog" aria-modal="true" aria-labelledby="cancel-review-title" @onclick:stopPropagation="true">
            <header class="booking-modal__header">
                <div>
                    <p class="guide-eyebrow">Cancellation review</p>
                    <h2 id="cancel-review-title">@_selectedRequest.BookingCode</h2>
                    <span>@_selectedRequest.TourName</span>
                </div>
                <button class="guide-icon-button" type="button" title="Close" @onclick="CloseReviewModal">
                    <MaterialIcon Name="close" />
                </button>
            </header>

            <div class="cancellation-modal__summary">
                <div>
                    <span>Customer</span>
                    <strong>@_selectedRequest.CustomerName</strong>
                    <small>@_selectedRequest.CustomerEmail</small>
                </div>
                <div>
                    <span>Booking status</span>
                    <strong>@_selectedRequest.Status</strong>
                    <small>Departure @_selectedRequest.DepartureDate.ToString("dd/MM/yyyy")</small>
                </div>
                <div>
                    <span>Requested at</span>
                    <strong>@FormatDateTime(_selectedRequest.CancellationRequestedAt)</strong>
                    <small>@GetCancellationStatus(_selectedRequest)</small>
                </div>
            </div>

            <div class="guide-form-field">
                <label>Customer reason</label>
                <textarea rows="4" readonly>@(string.IsNullOrWhiteSpace(_selectedRequest.CancellationReason) ? "No reason provided." : _selectedRequest.CancellationReason)</textarea>
            </div>

            @if (readOnly)
            {
                <div class="cancellation-review-note">
                    <MaterialIcon Name="@(_selectedRequest.CancellationStatus == "Approved" ? "check_circle" : "block")" />
                    <div>
                        <strong>@GetCancellationStatus(_selectedRequest)</strong>
                        <p>Reviewed by @(_selectedRequest.CancellationReviewedBy ?? "Admin staff") on @FormatDateTime(_selectedRequest.CancellationReviewedAt).</p>
                        @if (!string.IsNullOrWhiteSpace(_selectedRequest.CancellationReviewNote))
                        {
                            <p>@_selectedRequest.CancellationReviewNote</p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="booking-form-grid booking-form-grid--two">
                    <div class="guide-form-field">
                        <label>Decision</label>
                        <select @bind="_reviewStatus">
                            <option value="Approved">Approve cancellation</option>
                            <option value="Rejected">Reject request</option>
                        </select>
                    </div>
                    <div class="guide-form-field">
                        <label>Reviewed by</label>
                        <input value="@_reviewedBy" readonly />
                    </div>
                </div>

                <div class="guide-form-field">
                    <label>Staff note</label>
                    <textarea rows="3" maxlength="1000" @bind="_reviewNote" placeholder="Add a short note for this review."></textarea>
                </div>

                @if (!string.IsNullOrWhiteSpace(_reviewError))
                {
                    <div class="guide-alert guide-alert--error">@_reviewError</div>
                }

                <footer class="booking-modal__footer">
                    <button class="wx-button wx-button--outline" type="button" @onclick="CloseReviewModal" disabled="@_isReviewing">
                        Cancel
                    </button>
                    <button class="wx-button wx-button--secondary" type="button" @onclick="SubmitReviewAsync" disabled="@_isReviewing">
                        <MaterialIcon Name="@(_isReviewing ? "sync" : "fact_check")" />
                        @(_isReviewing ? "Saving..." : "Save decision")
                    </button>
                </footer>
            }
        </section>
    </div>
}

