@code {
    private enum QuizPhase { Splash, Question, Result }

    private QuizPhase _phase = QuizPhase.Splash;
    private List<QuizQuestionClientDto>? _questions;
    private int _currentIndex = 0;
    private Dictionary<int, Guid> _answers = new(); // key = question index, value = option ID
    private TravelStyleQuizResultResponse? _result;
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadQuestionsAsync();
    }

    private async Task LoadQuestionsAsync()
    {
        _isLoading = true;
        _errorMessage = string.Empty;
        StateHasChanged();
        try
        {
            var result = await ApiClient.GetQuizQuestionsAsync();
            _questions = result?.OrderBy(q => q.DisplayOrder).ToList() ?? new List<QuizQuestionClientDto>();
            if (_questions.Count == 0)
            {
                _errorMessage = "Chưa có câu hỏi nào. Vui lòng liên hệ admin.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Không thể tải câu hỏi: {ex.Message}";
            _questions = new List<QuizQuestionClientDto>();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void StartQuiz()
    {
        if (_questions is { Count: > 0 })
        {
            _currentIndex = 0;
            _answers.Clear();
            _phase = QuizPhase.Question;
        }
    }

    private void SelectOption(Guid optionId)
    {
        _answers[_currentIndex] = optionId;
        _errorMessage = string.Empty;
    }

    private void GoBack()
    {
        if (_currentIndex > 0)
        {
            _currentIndex--;
        }
        else
        {
            _phase = QuizPhase.Splash;
        }
    }

    private void GoNext()
    {
        if (_answers.ContainsKey(_currentIndex) && _currentIndex < (_questions?.Count ?? 0) - 1)
        {
            _currentIndex++;
        }
    }

    private async Task SubmitQuiz()
    {
        if (_questions is null || !_answers.ContainsKey(_currentIndex)) return;

        var session = await SessionService.GetAsync();
        if (session is null || string.IsNullOrEmpty(session.Email))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            if (_answers.Count != _questions.Count)
            {
                _errorMessage = "Vui lòng trả lời đầy đủ tất cả câu hỏi.";
                return;
            }

            var answers = _questions.Select((question, index) => new QuizAnswerDto
            {
                QuestionId = question.Id,
                OptionId = _answers[index]
            }).ToList();

            var request = new TravelStyleQuizSubmitRequest { Answers = answers };

            _result = await ApiClient.SubmitQuizResultAsync(request);
            _phase = QuizPhase.Result;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Nộp bài thất bại: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private static StyleInfo GetStyleInfo(string dominantStyle)
    {
        return dominantStyle.ToLowerInvariant() switch
        {
            "adventure" => new StyleInfo
            {
                Title = "Người Khám phá Mạo hiểm",
