@page "/travel-quiz"
@using WanderXClient.Models
@using WanderXClient.Services
@inject UserApiClient ApiClient
@inject AuthSessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Travel Style Quiz - WanderX</PageTitle>

@if (_phase == QuizPhase.Splash)
{
    <!-- ── PHASE 1: Splash Intro (quiz1.html) ──────────────────────────────── -->
    <div class="tqz-splash">
        <div class="tqz-splash__bg">
            <div class="tqz-splash__overlay"></div>
            <div class="tqz-splash__img tqz-animate-zoom"></div>
        </div>

        <header class="tqz-splash__header">
            <span class="tqz-brand">WanderX</span>
            <button class="tqz-splash__close" @onclick='() => Navigation.NavigateTo("/")'>
                <span class="material-symbols-outlined">close</span>
            </button>
        </header>

        <aside class="tqz-splash__corner tqz-splash__corner--left">
            <div class="tqz-mag-side">
                <div class="tqz-mag-side__num">01/0@(_questions?.Count ?? 5)</div>
                <div class="tqz-mag-side__label">Trải nghiệm đỉnh cao</div>
            </div>
        </aside>

        <aside class="tqz-splash__corner tqz-splash__corner--right">
            <div class="tqz-glass-card">
                <div class="tqz-glass-card__row">
                    <div class="tqz-verified-dot">
                        <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1; font-size:16px">verified</span>
                    </div>
                    <span class="tqz-glass-card__label">98% Match Rate</span>
                </div>
                <p class="tqz-glass-card__desc">Hệ thống AI phân tích hơn 500 biến số để tìm điểm đến hoàn hảo cho bạn.</p>
            </div>
        </aside>

        <main class="tqz-splash__main">
            <div class="tqz-tag">Exclusive Experience</div>
            <div class="tqz-splash__headline-wrap">
                <h1 class="tqz-splash__h1">Khám phá <em>Phong cách Du lịch</em> của Bạn</h1>
                <div class="tqz-mag-line"></div>
            </div>
            <p class="tqz-splash__sub">Dành 2 phút để chúng tôi cá nhân hóa những hành trình trong mơ của riêng bạn.</p>

            @if (_isLoading)
            {
                <div class="tqz-splash__cta-wrap">
                    <button class="tqz-splash__cta" disabled>
                        <span class="material-symbols-outlined tqz-spin">progress_activity</span>
                        Đang tải câu hỏi…
                    </button>
                </div>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                <p class="tqz-splash__error">@_errorMessage</p>
                <button class="tqz-splash__cta" @onclick="LoadQuestionsAsync">Thử lại</button>
            }
            else
            {
                <div class="tqz-splash__cta-wrap">
                    <div class="tqz-cta-glow"></div>
                    <button class="tqz-splash__cta" @onclick="StartQuiz">
                        Bắt đầu Khảo sát
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </div>
            }

            <div class="tqz-scroll-indicator">
                <span class="tqz-scroll-label">Scroll for details</span>
                <div class="tqz-scroll-line"></div>
            </div>
        </main>
    </div>
}
else if (_phase == QuizPhase.Question && _questions != null && _currentIndex < _questions.Count)
{
    <!-- ── PHASE 2: Question Page (quiz2.html layout) ──────────────────────── -->
    var q = _questions[_currentIndex];
    int progress = (int)Math.Round((_currentIndex / (double)_questions.Count) * 100);
    <div class="tqz-quiz">
        <header class="tqz-quiz__header">
            <div class="tqz-quiz__brand">
                <span class="material-symbols-outlined">menu</span>
                <span class="tqz-brand tqz-brand--dark">WanderX</span>
            </div>
            <div class="tqz-quiz__header-right">
                <button class="tqz-skip-btn" @onclick='() => Navigation.NavigateTo("/")'>Skip Quiz</button>
                <span class="material-symbols-outlined tqz-user-icon">account_circle</span>
            </div>
        </header>

        <main class="tqz-quiz__main">
            <div class="tqz-quiz__inner">
                <!-- Progress -->
                <div class="tqz-progress-wrap">
                    <div class="tqz-progress__meta">
                        <span class="tqz-progress__counter">Câu hỏi @(_currentIndex + 1)/@_questions.Count</span>
                        <span class="tqz-progress__label">Travel Style Quiz</span>
                    </div>
                    <div class="tqz-progress-bar">
                        <div class="tqz-progress-bar__fill" style="width:@(progress)%"></div>
                    </div>
                </div>

                <!-- Question Text -->
                <h1 class="tqz-quiz__question">@q.Text</h1>

                <!-- Option Cards Grid -->
                <div class="tqz-options-grid">
                    @foreach (var opt in q.Options)
                    {
                        var isSelected = _answers.TryGetValue(_currentIndex, out var sel) && sel == opt.Id;
                        <label class="tqz-option-label @(isSelected ? "tqz-option-label--selected" : "")">
                            <input type="radio"
                                   name="quiz-option"
                                   value="@opt.OptionKey"
                                   class="tqz-option-radio"
                                   checked="@isSelected"
                                   @onchange="() => SelectOption(opt.Id)" />
                            <div class="tqz-option-card">
                                <div class="tqz-option-card__check">
                                    <span class="material-symbols-outlined">check</span>
                                </div>
                                <div class="tqz-option-card__body">
                                    <span class="tqz-option-key">@opt.OptionKey</span>
                                    <p class="tqz-option-text">@opt.Text</p>
                                </div>
                            </div>
                        </label>
                    }
                </div>
            </div>
        </main>

        <!-- Footer Navigation -->
        <footer class="tqz-quiz__footer">
            <button class="tqz-nav-btn tqz-nav-btn--back" @onclick="GoBack"
                    disabled="@(_currentIndex == 0)">
                <span class="material-symbols-outlined">arrow_back</span>
                Quay lại
            </button>
            <div class="tqz-footer-right">
                <span class="tqz-footer-hint">@(!string.IsNullOrEmpty(_errorMessage) ? _errorMessage : (_answers.ContainsKey(_currentIndex) ? "" : "Hãy chọn một lựa chọn để tiếp tục"))</span>
                @if (_currentIndex < _questions.Count - 1)
                {
                    <button class="tqz-nav-btn tqz-nav-btn--next"
                            @onclick="GoNext"
                            disabled="@(!_answers.ContainsKey(_currentIndex))">
                        Tiếp theo
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                }
                else
                {
                    <button class="tqz-nav-btn tqz-nav-btn--submit"
                            @onclick="SubmitQuiz"
                            disabled="@(_isSaving || !_answers.ContainsKey(_currentIndex))">
                        @if (_isSaving)
                        {
                            <span class="material-symbols-outlined tqz-spin">progress_activity</span>
                        }
                        Nộp bài
                        <span class="material-symbols-outlined">check_circle</span>
                    </button>
                }
            </div>
        </footer>
    </div>
}
else if (_phase == QuizPhase.Result && _result != null)
{
    <!-- ── PHASE 3: Result Page (quizresult.html layout) ──────────────────── -->
    var styleInfo = GetStyleInfo(_result.DominantStyle);
    int totalScore = _result.AdventureScore + _result.CulturalScore + _result.RelaxationScore + _result.LuxuryScore;
    int advPct   = totalScore > 0 ? (int)Math.Round(_result.AdventureScore   * 100.0 / totalScore) : 0;
    int culPct   = totalScore > 0 ? (int)Math.Round(_result.CulturalScore    * 100.0 / totalScore) : 0;
    int relPct   = totalScore > 0 ? (int)Math.Round(_result.RelaxationScore  * 100.0 / totalScore) : 0;
    int luxPct   = totalScore > 0 ? (int)Math.Round(_result.LuxuryScore      * 100.0 / totalScore) : 0;

    <div class="tqz-result">
        <header class="tqz-result__topbar">
            <div class="tqz-result__topbar-left">
                <a href="/" class="tqz-brand tqz-brand--dark">WanderX</a>
            </div>
        </header>

        <main class="tqz-result__main">
            <!-- Hero Result section -->
            <section class="tqz-result__hero">
                <div class="tqz-result__hero-text">
                    <span class="tqz-result-badge">Kết quả bài trắc nghiệm</span>
                    <h1 class="tqz-result__h1">
                        Phong cách của bạn:<br/>
                        <span class="tqz-result__style-name" style="color:@styleInfo.Color">@styleInfo.Title</span>
                    </h1>
                    <p class="tqz-result__desc">@styleInfo.Description</p>
                    <div class="tqz-result__tags">
                        @foreach (var tag in styleInfo.Tags)
                        {
                            <span class="tqz-result__tag">
                                <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 1">@tag.Icon</span>
                                @tag.Label
                            </span>
                        }
                    </div>
                </div>
                <div class="tqz-result__hero-img-wrap">
                    <div class="tqz-result__hero-glow"></div>
                    <div class="tqz-result__hero-img">
                        <div class="tqz-result__hero-img-overlay"></div>
                        <div class="tqz-result__hero-quote">
                            <p class="tqz-result__hero-quote-label">Cảm hứng dành cho bạn</p>
                            <p class="tqz-result__hero-quote-text">"@styleInfo.Quote"</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Score breakdown -->
            <section class="tqz-scores">
                <h2 class="tqz-scores__title">Phân tích phong cách du lịch</h2>
                <div class="tqz-score-grid">
                    <div class="tqz-score-row">
                        <span class="tqz-score-label">🧗 Mạo hiểm</span>
                        <div class="tqz-score-bar-wrap">
                            <div class="tqz-score-bar tqz-score-bar--adventure" style="width:@(advPct)%"></div>
                        </div>
                        <span class="tqz-score-pct">@advPct%</span>
                    </div>
                    <div class="tqz-score-row">
                        <span class="tqz-score-label">🏛️ Văn hóa</span>
                        <div class="tqz-score-bar-wrap">
                            <div class="tqz-score-bar tqz-score-bar--cultural" style="width:@(culPct)%"></div>
                        </div>
                        <span class="tqz-score-pct">@culPct%</span>
                    </div>
                    <div class="tqz-score-row">
                        <span class="tqz-score-label">🏖️ Nghỉ dưỡng</span>
                        <div class="tqz-score-bar-wrap">
                            <div class="tqz-score-bar tqz-score-bar--relaxation" style="width:@(relPct)%"></div>
                        </div>
                        <span class="tqz-score-pct">@relPct%</span>
                    </div>
                    <div class="tqz-score-row">
                        <span class="tqz-score-label">💎 Thượng lưu</span>
                        <div class="tqz-score-bar-wrap">
                            <div class="tqz-score-bar tqz-score-bar--luxury" style="width:@(luxPct)%"></div>
                        </div>
                        <span class="tqz-score-pct">@luxPct%</span>
                    </div>
                </div>
            </section>

            <!-- Suggested Tours -->
            <section class="tqz-tours">
                <div class="tqz-tours__header">
                    <div>
                        <h2 class="tqz-tours__title">Tour gợi ý cho bạn</h2>
                        <p class="tqz-tours__sub">Lựa chọn dựa trên sở thích và phong cách riêng của bạn.</p>
                    </div>
                    <a href="/recommendations" class="tqz-see-all">Xem gợi ý thực tế <span class="material-symbols-outlined">arrow_forward</span></a>
                </div>
                <div class="tqz-tour-cards">
                    @foreach (var tour in styleInfo.SuggestedTours)
                    {
                        <div class="tqz-tour-card">
                            <div class="tqz-tour-card__img-wrap">
                                <div class="tqz-tour-card__img" style="background-image:url('@tour.ImageKeyword')"></div>
                                <div class="tqz-tour-card__badge">@tour.Badge</div>
                            </div>
                            <div class="tqz-tour-card__body">
                                <div class="tqz-tour-card__top">
                                    <h3 class="tqz-tour-card__title">@tour.Name</h3>
                                    <span class="material-symbols-outlined tqz-fav-icon">favorite</span>
                                </div>
                                <div class="tqz-tour-card__meta">
                                    <span><span class="material-symbols-outlined">schedule</span>@tour.Duration</span>
                                    <span><span class="material-symbols-outlined">star</span>@tour.Rating</span>
                                </div>
                                <div class="tqz-tour-card__footer">
                                    <div>
                                        <p class="tqz-price-label">Giá từ</p>
                                        <p class="tqz-price">@tour.PriceDisplay</p>
                                    </div>
                                    <a href="/recommendations" class="tqz-book-btn">Xem tour phù hợp</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- CTA Banner -->
            <section class="tqz-cta-banner">
                <div class="tqz-cta-banner__deco"></div>
                <div class="tqz-cta-banner__content">
                    <h2 class="tqz-cta-banner__h2">Bạn đã sẵn sàng cho chuyến đi tiếp theo?</h2>
                    <p class="tqz-cta-banner__sub">Đăng ký để nhận những ưu đãi đặc quyền và hành trình thiết kế riêng cho bạn.</p>
                    <div class="tqz-cta-banner__actions">
                        <button class="tqz-retake-btn" @onclick="() => _phase = QuizPhase.Splash">
                            <span class="material-symbols-outlined">refresh</span>
                            Làm lại Quiz
                        </button>
                        <a href="/profile" class="tqz-view-profile-btn">
                            Xem Hồ Sơ
                            <span class="material-symbols-outlined">person</span>
                        </a>
                    </div>
                </div>
            </section>
        </main>
    </div>
}

<style>
/* ══════════════════════════════════════════════════════════════════════
   FONTS & BASE
   ══════════════════════════════════════════════════════════════════════ */
@@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@@400;500;600;700;800&family=Inter:wght@@400;500;600&family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&display=swap');

.material-symbols-outlined {
    font-family: 'Material Symbols Outlined';
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    vertical-align: middle;
}

/* ══════════════════════════════════════════════════════════════════════
   SHARED
   ══════════════════════════════════════════════════════════════════════ */
.tqz-brand {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.5px;
    text-decoration: none;
}

.tqz-brand--dark { color: #0f172a; }

.tqz-spin { animation: tqz-spin 1s linear infinite; display: inline-block; }
@@keyframes tqz-spin { to { transform: rotate(360deg); } }

/* ══════════════════════════════════════════════════════════════════════
   PHASE 1 – SPLASH
   ══════════════════════════════════════════════════════════════════════ */
.tqz-splash {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    background: #0f172a;
}

.tqz-splash__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
}

.tqz-splash__img {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1920&q=80');
    background-size: cover;
    background-position: center;
}

.tqz-animate-zoom {
    animation: tqz-zoom 20s ease-in-out infinite alternate;
}
@@keyframes tqz-zoom {
    from { transform: scale(1); }
    to   { transform: scale(1.06); }
}

.tqz-splash__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom,
        rgba(15,23,42,0.1) 0%,
        rgba(15,23,42,0.4) 40%,
        rgba(15,23,42,0.85) 100%);
    z-index: 1;
}

/* Header */
.tqz-splash__header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 32px;
    box-sizing: border-box;
}

.tqz-splash__header .tqz-brand { color: #ffffff; }

.tqz-splash__close {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    backdrop-filter: blur(8px);
    transition: background 0.2s;
}
.tqz-splash__close:hover { background: rgba(255,255,255,0.22); }

/* Corner decorations */
.tqz-splash__corner {
    position: absolute;
    z-index: 10;
}

.tqz-splash__corner--left {
    top: 128px;
    left: 32px;
}

.tqz-splash__corner--right {
    bottom: 48px;
    right: 32px;
    width: 260px;
}

.tqz-mag-side {
    border-left: 1px solid rgba(255,255,255,0.3);
    padding-left: 16px;
}

.tqz-mag-side__num {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
}

.tqz-mag-side__label {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.5);
    margin-top: 4px;
}

.tqz-glass-card {
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
    padding: 20px;
}

.tqz-glass-card__row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
}

.tqz-verified-dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #0284c7;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex-shrink: 0;
}

.tqz-glass-card__label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
}

.tqz-glass-card__desc {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(255,255,255,0.6);
    margin: 0;
}

/* Main content */
.tqz-splash__main {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1280px;
    padding: 0 32px 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-sizing: border-box;
}

.tqz-tag {
    display: inline-block;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.2);
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding: 6px 18px;
    border-radius: 9999px;
    margin-bottom: 24px;
}

.tqz-splash__headline-wrap {
    margin-bottom: 24px;
}

.tqz-splash__h1 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(36px, 6vw, 72px);
    font-weight: 800;
    line-height: 1.12;
    color: #ffffff;
    margin: 0 0 16px;
}

.tqz-splash__h1 em {
    font-style: italic;
    font-weight: 400;
}

.tqz-mag-line {
    height: 1px;
    width: 96px;
    margin: 0 auto;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.8) 50%, transparent 100%);
    opacity: 0.5;
}

.tqz-splash__sub {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255,255,255,0.9);
    max-width: 520px;
    margin: 0 auto 48px;
}

.tqz-splash__cta-wrap {
    position: relative;
    display: inline-block;
}

.tqz-cta-glow {
    position: absolute;
    inset: -4px;
    background: #ff5a5f;
    border-radius: 9999px;
    filter: blur(12px);
    opacity: 0.3;
    transition: opacity 0.3s;
}

.tqz-splash__cta-wrap:hover .tqz-cta-glow { opacity: 0.55; }

.tqz-splash__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 20px 48px;
    background: #ff5a5f;
    color: #ffffff;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 18px;
    font-weight: 700;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    box-shadow: 0 8px 32px rgba(255,90,95,0.4);
    transition: transform 0.15s, opacity 0.15s;
}

.tqz-splash__cta:hover { transform: translateY(-2px); }
.tqz-splash__cta:active { transform: scale(0.96); }
.tqz-splash__cta:disabled { opacity: 0.6; cursor: not-allowed; }

.tqz-splash__error {
    color: rgba(255,100,100,0.9);
    font-size: 14px;
    margin-bottom: 12px;
}

.tqz-scroll-indicator {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0.5;
    z-index: 5;
}

.tqz-scroll-label {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: #ffffff;
}

.tqz-scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, #ffffff, transparent);
}

/* ══════════════════════════════════════════════════════════════════════
