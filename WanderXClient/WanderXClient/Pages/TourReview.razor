@page "/tour-review/{BookingId:guid}"
@using WanderXClient.Models
@using WanderXClient.Services
@inject UserApiClient UserApi
@inject AuthSessionService SessionService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

<PageTitle>WanderX - Tour Review</PageTitle>

<AppHeader />

@if (_isLoading)
{
    <div class="flex justify-center items-center min-h-[60vh]">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 !border-primary"></div>
    </div>
}
else if (_session == null)
{
    <main class="flex-grow max-w-7xl w-full mx-auto px-6 py-24 text-center">
        <span class="material-symbols-outlined text-5xl text-muted-fg">login</span>
        <h2 class="font-title font-bold text-xl !text-primary mt-4">Please log in</h2>
        <a href="/login" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold !text-primary hover:underline">
            Log in
        </a>
    </main>
}
else if (_booking == null)
{
    <main class="flex-grow max-w-7xl w-full mx-auto px-6 py-24 text-center">
        <span class="material-symbols-outlined text-5xl text-muted-fg">error_outline</span>
        <h2 class="font-title font-bold text-xl !text-primary mt-4">Booking not found</h2>
        <a href="/my-bookings" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold !text-primary hover:underline">
            <span class="material-symbols-outlined text-base">arrow_back</span> Back to list
        </a>
    </main>
}
else if (!_booking.CompletedAt.HasValue)
{
    <main class="flex-grow max-w-7xl w-full mx-auto px-6 py-24 text-center">
        <span class="material-symbols-outlined text-5xl text-muted-fg">lock</span>
        <h2 class="font-title font-bold text-xl !text-primary mt-4">Review not available yet</h2>
        <p class="text-sm text-muted-fg mt-2">You can only review a tour after the trip is completed.</p>
        <a href="/booking-detail/@_booking.Id" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold !text-primary hover:underline">
            <span class="material-symbols-outlined text-base">arrow_back</span> Back to details
        </a>
    </main>
}
else
{
    <main class="flex-grow max-w-7xl w-full mx-auto px-6 py-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">

            <aside class="lg:col-span-4 bg-white border border-hairline rounded-lg p-6 space-y-6 shadow-sm">
                <div class="flex flex-col items-center text-center pb-6 border-b border-hairline">
                    <div class="w-20 h-20 rounded-full overflow-hidden border-2 !border-primary mb-4">
                        <img alt="User Avatar" class="w-full h-full object-cover" src="@_avatarUrl">
                    </div>
                    <h3 class="font-title font-bold text-lg !text-primary">@_session.FullName</h3>
                    <span class="text-xs font-semibold text-muted-fg">@_session.Email</span>
                </div>
                <nav class="flex flex-col gap-1 text-sm font-semibold text-muted-fg">
                    <a href="my-bookings" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-surface-soft hover:!text-primary transition-colors">
                        <span class="material-symbols-outlined text-lg">receipt_long</span>
                        My Bookings
                    </a>
                    <a href="service-requests" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-surface-soft hover:!text-primary transition-colors">
                        <span class="material-symbols-outlined text-lg">description</span>
                        Service Requests
                    </a>
                    <a href="profile" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-surface-soft hover:!text-primary transition-colors">
                        <span class="material-symbols-outlined text-lg">person</span>
                        Profile
                    </a>
                </nav>
            </aside>

            <section class="lg:col-span-8 space-y-8">
                <!-- Header -->
                <div class="space-y-4">
                    <div class="flex items-center gap-4">
                        <a href="/booking-detail/@_booking.Id" class="flex items-center gap-2 text-sm font-semibold !text-primary hover:underline">
                            <span class="material-symbols-outlined text-base">arrow_back</span>
                            Back
                        </a>
                    </div>
                    <h1 class="text-2xl font-extrabold tracking-tight font-title !text-primary">Tour Reviews</h1>
                    <p class="text-sm text-muted-fg">Share your experience with tour @_booking.TourName</p>
                </div>

                <div class="bg-white border border-hairline rounded-lg p-6 shadow-sm">
                    <div class="flex gap-4">
                        @if (!string.IsNullOrEmpty(_booking.ThumbnailUrl))
                        {
                            <img src="@_booking.ThumbnailUrl" alt="@_booking.TourName" class="w-24 h-24 object-cover rounded-lg">
                        }
                        <div class="flex-1">
                            <h3 class="font-semibold !text-primary">@_booking.TourName</h3>
                            <p class="text-sm text-muted-fg">@_booking.Destination</p>
                            <p class="text-xs text-muted-fg mt-2">Booking code: @_booking.BookingCode</p>
                            <p class="text-xs text-muted-fg">Travel Date: @_booking.DepartureDate.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white border border-hairline rounded-lg p-6 md:p-8 space-y-6 shadow-sm">

                    @if (_existingReview != null)
                    {
                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                            <p class="text-sm text-blue-800">
                                <strong>You reviewed this tour on @_existingReview.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy").</strong>
                                You can edit or delete your review.
                            </p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                            <p class="text-sm text-red-800">
                                <strong>⚠ Error:</strong> @_errorMessage
                            </p>
                        </div>
                    }

                    @if (_successMessage)
                    {
                        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                            <p class="text-sm text-green-800">
                                <strong>✓ Success!</strong> Your review has been saved.
                            </p>
                        </div>
                    }

                    <div class="space-y-3">
                        <label class="text-sm font-semibold !text-primary">Your rating <span class="text-red-500">*</span></label>
                        <div class="flex gap-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                var starIndex = i;
                                <button type="button" class="text-3xl transition-colors" @onclick="@(() => SetRating(starIndex))">
                                    @if (_rating >= starIndex)
                                    {
                                        <span class="material-symbols-outlined text-yellow-400" style="font-variation-settings:'FILL' 1">star</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-gray-300">star</span>
                                    }
                                </button>
                            }
                        </div>
                        <p class="text-xs text-muted-fg">
                            @if (_rating == 0)
                            {
                                <span>Click a star to rate (1-5 stars)</span>
                            }
                            else
                            {
                                <span class="font-semibold">You selected: @_rating stars</span>
                            }
                        </p>
                    </div>

                    <!-- Comment -->
                    <div class="space-y-3">
                        <label class="text-sm font-semibold !text-primary">Your comment</label>
                        <textarea class="w-full border border-hairline rounded-lg p-3 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-primary/30"
                                  rows="5"
                                  @bind="_comment"
                                  placeholder="Share your experience from the trip...">
                        </textarea>
                    </div>

                    <div class="flex gap-3 justify-end pt-2">
                        <a href="/booking-detail/@_booking.Id" class="wx-button wx-button--outline">
                            Cancel
                        </a>
                        @if (_existingReview != null)
                        {
                            <button class="wx-button" style="background:#ef4444;color:white;" @onclick="DeleteReview" disabled="@_isSubmitting">
                                Delete review
                            </button>
                        }
                        <button class="wx-button wx-button--secondary"
                                @onclick="SubmitReview"
                                disabled="@(_rating == 0 || _isSubmitting)">
                            @if (_isSubmitting)
                            {
                                <span class="animate-spin rounded-full h-4 w-4 border-b-2 border-white inline-block mr-2"></span>
                                <span>Submitting...</span>
                            }
                            else
                            {
                                <span>@(_existingReview != null ? "Update review" : "Submit review")</span>
                            }
                        </button>
                    </div>
                </div>
            </section>
        </div>
    </main>
}

<AppFooter />

@code {
    [Parameter] public Guid BookingId { get; set; }

    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private bool _successMessage = false;
    private string _errorMessage = string.Empty;

    private AuthSession? _session;
    private string _avatarUrl = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=200";
    private BookingSummaryResponse? _booking;
    private TourReviewResponse? _existingReview;

    private int _rating = 0;
    private string _comment = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _session = await SessionService.GetAsync();
        if (_session == null)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        try
        {
            try
            {
                var savedAvatar = await JSRuntime.InvokeAsync<string>("localStorage.getItem", $"avatar_{_session.Email}");
                if (!string.IsNullOrEmpty(savedAvatar))
                    _avatarUrl = savedAvatar;
            }
            catch { /* Ignore localStorage errors. */ }

            _booking = await UserApi.GetBookingByIdAsync(BookingId);

            if (_booking != null)
            {
                _existingReview = await UserApi.GetReviewByBookingIdAsync(BookingId);
                if (_existingReview != null)
                {
                    _rating = _existingReview.Rating;
                    _comment = _existingReview.Comment ?? string.Empty;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Error loading page: " + ex.Message;
            _booking = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SetRating(int rating)
    {
        _rating = rating;
        _errorMessage = string.Empty;
    }

    private async Task SubmitReview()
    {
        if (_booking == null || _rating == 0)
        {
            _errorMessage = "Please choose a rating before submitting.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = string.Empty;
        _successMessage = false;

        try
        {
            if (_existingReview != null)
            {
                var updateRequest = new UpdateTourReviewRequest
                {
                    Rating = _rating,
                    Comment = string.IsNullOrWhiteSpace(_comment) ? null : _comment.Trim(),
                    TravelPhotos = null
                };
                await UserApi.UpdateReviewAsync(_existingReview.Id, updateRequest);
            }
            else
            {
                var createRequest = new CreateTourReviewRequest
                {
                    BookingId = _booking.Id,
                    Rating = _rating,
                    Comment = string.IsNullOrWhiteSpace(_comment) ? null : _comment.Trim(),
                    TravelPhotos = null
                };
                await UserApi.CreateReviewAsync(createRequest);
            }

            NavManager.NavigateTo("/booking-detail/" + _booking.Id);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task DeleteReview()
    {
        if (_existingReview == null || _booking == null) return;

        _isSubmitting = true;
        _errorMessage = string.Empty;

        try
        {
            await UserApi.DeleteReviewAsync(_existingReview.Id);
            NavManager.NavigateTo("/booking-detail/" + _booking.Id);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
