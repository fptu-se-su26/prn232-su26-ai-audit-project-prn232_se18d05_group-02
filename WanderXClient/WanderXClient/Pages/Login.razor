@page "/login"
@inject AuthApiClient AuthApi
@inject AuthSessionService AuthSession
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Sign In - WanderX</PageTitle>

<AuthShell
    Title="Welcome Back"
    Subtitle="Sign in to manage your world-class itineraries."
    BackgroundImage="https://lh3.googleusercontent.com/aida-public/AB6AXuD6mmZhLrmOyAAYQ460Zgai8wrgefQ9WMciwZz0zPcYLJ4I1QxcLK8SYfD_6sm8AujNYguKOeHbu_cNtCBIQJRjCNR0f98_UfQZmbRhSQVR0woB7pKAstv5ZmNSzL81knkvwr6Ql3DoOA2f2qDV4wJY1IC-dGwSQ9bLCR4ifWZ2Fwh2JJ6jJtl6T1U-UlhgOnFyyQ-QjhrC_bssMXYq6YEiZh6lbG6qyPvJgeudlXB7WZt37odHFywpOmBOTpP65QJRj7avSLd_fA">
    <EditForm Model="@_model" OnValidSubmit="@SubmitAsync" class="auth-form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <AuthInput
            Id="login-email"
            Label="Account"
            Icon="mail"
            Type="text"
            AutoComplete="username"
            Placeholder="ad@ad.123"
            @bind-Value="_model.Email" />

        <div>
            <div class="auth-row mb-2">
                <label class="auth-input__label" for="login-password">Password</label>
                <a class="auth-link" href="/forgot-password">Forgot Password?</a>
            </div>
            <AuthInput
                Id="login-password"
                Label="Password"
                ShowLabel="false"
                Icon="lock"
                Type="password"
                AutoComplete="current-password"
                Placeholder="********"
                @bind-Value="_model.Password" />
        </div>

        <label class="auth-check">
            <InputCheckbox @bind-Value="_model.RememberMe" />
            Keep me logged in
        </label>

        <button class="wx-button" type="submit" disabled="@_isBusy">
            @(_isBusy ? "Signing In..." : "Sign In")
            <MaterialIcon Name="arrow_forward" />
        </button>

        <AuthStatusMessage Message="@_message" IsError="@_isError" />

        <div class="auth-divider">Or continue with</div>

        <div class="social-grid social-grid--single">
            <button class="social-button" type="button" @onclick="GoogleLogin">
                <span class="google-mark">G</span>
                Continue with Google
            </button>
        </div>

        <p class="auth-note">
            New to the management portal?
            <a class="auth-link" href="/register">Create an Account</a>
        </p>
    </EditForm>
</AuthShell>

@code {
    [SupplyParameterFromQuery(Name = "googleError")] public string? GoogleError { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private readonly LoginRequest _model = new();
    private bool _isBusy;
    private bool _isError;
    private string? _message;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(GoogleError))
        {
            _isError = true;
            _message = GoogleError == "GOOGLE_NOT_CONFIGURED"
                ? "Google Sign-In chưa được cấu hình. Vui lòng dùng tài khoản thường hoặc cấu hình Google Client ID/Secret."
                : $"Google Sign-In thất bại: {GoogleError}";
        }
    }

    private void GoogleLogin()
    {
        var apiBase = Configuration["ApiBaseUrl"] ?? "http://localhost:5009/";
        var safeReturn = !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") ? ReturnUrl : "/";
        Navigation.NavigateTo($"{apiBase.TrimEnd('/')}/api/auth/google/start?returnUrl={Uri.EscapeDataString(safeReturn)}", forceLoad: true);
    }
    private async Task SubmitAsync()
    {
        _isBusy = true;
        _message = null;
        _isError = false;

        try
        {
            var response = await AuthApi.LoginAsync(_model);

            if (response is null)
            {
                Navigation.NavigateTo("/");
                return;
            }

            await AuthSession.SaveAsync(response, _model.RememberMe);
            var target = !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//")
                ? ReturnUrl
                : GetRedirectPath(response.Role);
            Navigation.NavigateTo(target);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ToUserMessage(ex);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string ToUserMessage(Exception exception)
    {
        return exception.Message.Contains('{')
            ? "The server rejected the request. Please check your details and try again."
            : exception.Message;
    }

    private static string GetRedirectPath(string role)
    {
        return role.Trim().ToLowerInvariant() switch
        {
            "admin" => "/dashboard",
            "guide" or "guider" => "/guide-portal",
            _ => "/"
        };
    }
}

<style>.social-grid--single{grid-template-columns:1fr}.google-mark{display:grid;place-items:center;width:22px;height:22px;border-radius:50%;font-weight:800;color:#4285f4;background:#fff}</style>
