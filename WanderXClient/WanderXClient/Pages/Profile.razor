@page "/profile"
@using WanderXClient.Models
@using WanderXClient.Services
@inject UserApiClient UserApi
@inject AuthSessionService SessionService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

<PageTitle>WanderX - Thông tin cá nhân</PageTitle>

<AppHeader />

@if (_isLoading)
{
    <div class="flex justify-center items-center min-h-[60vh]">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 !border-primary"></div>
    </div>
}
else if (_profile != null)
{
    <!-- Main Container (Không có header/footer vì đã có ở AppHeader/AppFooter toàn cục) -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-6 py-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
            
            <!-- Left Profile Sidebar (4 cols) -->
            <aside class="lg:col-span-4 bg-white border border-hairline rounded-lg p-6 space-y-6">
                <div class="flex flex-col items-center text-center pb-6 border-b border-hairline">
                    <div class="relative mb-4">
                        <div class="w-20 h-20 rounded-full overflow-hidden border-2 !border-primary">
                            <img alt="User Avatar" class="w-full h-full object-cover" src="@_avatarUrl">
                        </div>
                        <label for="avatar-upload" class="absolute bottom-0 right-0 bg-white border border-hairline rounded-full w-7 h-7 flex items-center justify-center cursor-pointer shadow-sm hover:bg-surface-soft transition-colors text-muted-fg hover:!text-primary">
                            <span class="material-symbols-outlined text-[14px]">photo_camera</span>
                            <InputFile id="avatar-upload" class="hidden" OnChange="HandleAvatarChange" accept="image/*" />
                        </label>
                    </div>
                    <h3 class="font-title font-bold text-lg !text-primary">@_profile.FullName</h3>
                    <span class="text-xs font-semibold text-muted-fg">@_profile.Email</span>
                    
                </div>
                <nav class="flex flex-col gap-1 text-sm font-semibold text-muted-fg">
                    <a href="my-bookings" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-surface-soft hover:!text-primary transition-colors">
                        <span class="material-symbols-outlined text-lg">receipt_long</span>
                        Đơn hàng của tôi
                    </a>
                    <a href="service-requests" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-surface-soft hover:!text-primary transition-colors">
                        <span class="material-symbols-outlined text-lg">description</span>
                        Yêu cầu dịch vụ
                    </a>
                    <a href="profile" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-surface-soft !text-primary">
                        <span class="material-symbols-outlined text-lg">person</span>
                        Thông tin cá nhân
                    </a>
                    <a href="travel-quiz" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-surface-soft hover:!text-primary transition-colors">
                        <span class="material-symbols-outlined text-lg">quiz</span>
                        Trắc nghiệm Travel Style
                    </a>
                </nav>
            </aside>

            <!-- Right list content (8 cols) -->
            <section class="lg:col-span-8 space-y-8">
                <div class="border-b border-hairline pb-4">
                    <h1 class="text-2xl font-extrabold tracking-tight font-title !text-primary">Thông tin cá nhân</h1>
                    <p class="text-xs text-muted-fg mt-1">Cập nhật thông tin liên hệ và cài đặt bảo mật tài khoản.</p>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="bg-red-50 text-red-600 p-4 rounded-lg text-sm border border-red-200">
                        @_errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="bg-green-50 text-green-700 p-4 rounded-lg text-sm border border-green-200">
                        @_successMessage
                    </div>
                }

                <!-- Travel Badge Showcase -->
                @if (_latestQuiz != null)
                {
                    <div class="bg-gradient-to-r from-accent-orange/10 to-orange-400/5 border border-accent-orange/20 rounded-lg p-6 md:p-8 flex flex-col md:flex-row justify-between items-center gap-6">
                        <div class="space-y-2 text-center md:text-left">
                            <span class="text-xs font-bold text-accent-orange uppercase tracking-wider">Travel Style của bạn</span>
                            <h3 class="font-title font-bold text-xl !text-primary flex items-center justify-center md:justify-start gap-2">
                                <span class="material-symbols-outlined text-accent-orange">
                                    @(GetIconForStyle(_latestQuiz.DominantStyle))
                                </span>
                                @(GetTitleForStyle(_latestQuiz.DominantStyle))
                            </h3>
                            <p class="text-xs text-muted-fg max-w-lg leading-relaxed">
                                @(GetDescriptionForStyle(_latestQuiz.DominantStyle))
                            </p>
                            <div class="flex flex-wrap gap-3 mt-2 text-xs font-semibold text-muted-fg">
                                <span class="bg-surface-mid px-2.5 py-1 rounded">Mạo hiểm: @_latestQuiz.AdventureScore</span>
                                <span class="bg-surface-mid px-2.5 py-1 rounded">Văn hóa: @_latestQuiz.CulturalScore</span>
                                <span class="bg-surface-mid px-2.5 py-1 rounded">Nghỉ dưỡng: @_latestQuiz.RelaxationScore</span>
                                <span class="bg-surface-mid px-2.5 py-1 rounded">Thượng lưu: @_latestQuiz.LuxuryScore</span>
                            </div>
                        </div>
                        <a href="travel-quiz" class="!bg-primary hover:bg-primary/95 text-white font-semibold text-xs px-5 py-3 rounded-full transition-all flex-shrink-0">
                            Làm lại trắc nghiệm
                        </a>
                    </div>
                }
                else
                {
                    <div class="bg-gradient-to-r from-surface-mid to-surface-soft border border-hairline rounded-lg p-6 md:p-8 flex flex-col md:flex-row justify-between items-center gap-6">
                        <div class="space-y-2 text-center md:text-left">
                            <span class="text-xs font-bold text-muted-fg uppercase tracking-wider">Travel Style</span>
                            <h3 class="font-title font-bold text-xl !text-primary flex items-center justify-center md:justify-start gap-2">
                                <span class="material-symbols-outlined text-muted-fg">psychology</span>
                                Khám phá phong cách du lịch của bạn
                            </h3>
                            <p class="text-xs text-muted-fg max-w-lg leading-relaxed">
                                Hãy thực hiện bài trắc nghiệm nhanh để hệ thống đề xuất các tour du lịch phù hợp nhất với sở thích cá nhân của bạn.
                            </p>
                        </div>
                        <a href="travel-quiz" class="!bg-primary hover:bg-primary/95 text-white font-semibold text-xs px-5 py-3 rounded-full transition-all flex-shrink-0">
                            Bắt đầu trắc nghiệm
                        </a>
                    </div>
                }

                <!-- Settings edit form -->
                <EditForm Model="_updateModel" OnValidSubmit="HandleSubmit" class="bg-white border border-hairline rounded-lg p-6 md:p-8 space-y-6">
                    <DataAnnotationsValidator />

                    <h3 class="font-title font-bold text-base !text-primary">Thông tin liên lạc</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-muted-fg uppercase tracking-wider">Họ & Tên</label>
                            <InputText @bind-Value="_updateModel.FullName" class="w-full rounded-md border-hairline py-2.5 px-3.5 text-sm focus:ring-primary focus:border-primary" />
                            <ValidationMessage For="@(() => _updateModel.FullName)" class="text-xs text-red-500" />
                        </div>
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-muted-fg uppercase tracking-wider">Số điện thoại</label>
                            <InputText @bind-Value="_updateModel.PhoneNumber" class="w-full rounded-md border-hairline py-2.5 px-3.5 text-sm focus:ring-primary focus:border-primary" />
                            <ValidationMessage For="@(() => _updateModel.PhoneNumber)" class="text-xs text-red-500" />
                        </div>
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-muted-fg uppercase tracking-wider">Email</label>
                            <input type="email" readonly value="@_profile.Email" class="w-full rounded-md border-hairline bg-surface-soft text-muted-fg py-2.5 px-3.5 text-sm focus:ring-0 focus:outline-none cursor-not-allowed">
                        </div>
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-muted-fg uppercase tracking-wider">Địa chỉ</label>
                            <InputText @bind-Value="_updateModel.Address" class="w-full rounded-md border-hairline py-2.5 px-3.5 text-sm focus:ring-primary focus:border-primary" />
                        </div>
                    </div>

                    <h3 class="font-title font-bold text-base !text-primary pt-4 border-t border-hairline">Đổi mật khẩu</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-muted-fg uppercase tracking-wider">Mật khẩu hiện tại</label>
                            <InputText type="password" @bind-Value="_updateModel.CurrentPassword" placeholder="••••••••" class="w-full rounded-md border-hairline py-2.5 px-3.5 text-sm focus:ring-primary focus:border-primary" />
                        </div>
                        <div class="space-y-1.5">
                            <label class="block text-xs font-bold text-muted-fg uppercase tracking-wider">Mật khẩu mới</label>
                            <InputText type="password" @bind-Value="_updateModel.NewPassword" placeholder="Mật khẩu mới" class="w-full rounded-md border-hairline py-2.5 px-3.5 text-sm focus:ring-primary focus:border-primary" />
                            <ValidationMessage For="@(() => _updateModel.NewPassword)" class="text-xs text-red-500" />
                        </div>
                    </div>

                    <div class="flex justify-end pt-4">
                        <button type="submit" disabled="@_isSubmitting" class="!bg-primary hover:bg-primary/95 text-white font-semibold text-sm px-8 py-3 rounded-full transition-all shadow-sm disabled:opacity-50">
                            @if (_isSubmitting)
                            {
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <span>Lưu thay đổi</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </section>
        </div>
    </main>
    <AppFooter />
}


@code {
    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;
    
    private AuthSession? _session;
    private UserProfileResponse? _profile;
    private TravelStyleQuizResultResponse? _latestQuiz;
    private UpdateProfileRequest _updateModel = new();
    private string _avatarUrl = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=200";
    private const string AvatarLocalStorageKey = "wanderx.user.avatar";

    // Tính năng: Xem thông tin cá nhân
    // Bước 1: Khi trang Profile được khởi tạo (OnInitializedAsync chạy)
    // Bước 2: Gọi AuthSessionService.GetAsync() để lấy Session (lấy Email user) từ localStorage.
    // Bước 3: Nếu không có session, chuyển hướng về trang /login.
    // Bước 4: Gọi UserApiClient.GetProfileAsync(email) (Client - UserApiClient.cs)
    // Bước 5: UserApiClient gửi HTTP GET đến 'api/users/profile?email={email}' (Server - UsersController.cs)
    // Bước 6: UsersController gọi IUserService.GetProfileAsync(email) (Server - UserService.cs)
    // Bước 7: UserService truy vấn CSDL lấy ApplicationUser qua dbContext.Users, trả về UserProfileResponse
    // Bước 8: Dữ liệu trả về Client, gán vào biến _profile và map vào _updateModel để binding lên UI
    // Bước 9: Kết thúc. Dữ liệu hiển thị lên màn hình.
    
    protected override async Task OnInitializedAsync()
    {
        _session = await SessionService.GetAsync();
        
        if (_session == null)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        try
        {
            _profile = await UserApi.GetProfileAsync(_session.Email);
            if (_profile != null)
            {
                _updateModel.FullName = _profile.FullName;
                _updateModel.PhoneNumber = _profile.PhoneNumber;
                _updateModel.Address = _profile.Address;

                // Load avatar từ localStorage (nếu user đã từng upload)
                var savedAvatar = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", AvatarLocalStorageKey);
                if (!string.IsNullOrWhiteSpace(savedAvatar))
                {
                    _avatarUrl = savedAvatar;
                }
            }

            try
            {
                _latestQuiz = await UserApi.GetLatestQuizResultAsync();
            }
            catch (Exception)
            {
                // Ignore failure loading quiz result
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Không thể tải thông tin: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                (function() {
                    if (document.getElementById('tailwind-cdn')) return;
                    var script = document.createElement('script');
                    script.id = 'tailwind-cdn';
                    script.src = 'https://cdn.tailwindcss.com?plugins=forms,container-queries';
                    script.onload = function() {
                        tailwind.config = {
                            corePlugins: { preflight: false },
                            darkMode: 'class',
                            theme: {
                                extend: {
                                    colors: {
                                        primary: '#0f172a', 'on-primary': '#ffffff', canvas: '#ffffff',
                                        'surface-soft': '#f8fafc', 'surface-mid': '#f1f5f9', hairline: '#e2e8f0',
                                        'muted-fg': '#64748b', 'accent-orange': '#ff5a5f',
                                        'on-accent-orange': '#ffffff', 'accent-orange-soft': '#fff1f2'
                                    },
                                    fontFamily: {
                                        title: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
                                        body: ['Inter', 'sans-serif']
                                    }
                                }
                            }
                        };
                    };
                    document.head.appendChild(script);
                })();
            ");
        }
    }

    // Tính năng: Chỉnh sửa thông tin cá nhân
    // Bước 1: User điền form UI, nhấn submit
    // Bước 2: Kích hoạt hàm HandleSubmit qua EditForm
    // Bước 3: Đặt cờ _isSubmitting = true. Reset thông báo lỗi/thành công.
    // Bước 4: Gọi UserApiClient.UpdateProfileAsync(email, _updateModel) (Client - UserApiClient.cs)
    // Bước 5: UserApiClient gửi HTTP PUT body={_updateModel} đến 'api/users/profile?email={email}' (Server - UsersController.cs)
    // Bước 6: UsersController gọi IUserService.UpdateProfileAsync(email, request) (Server - UserService.cs)
    // Bước 7: UserService tìm ApplicationUser, update FullName, PhoneNumber, Address. Nếu có NewPassword thì hash pass và update. Lưu xuống CSDL.
    // Bước 8: Dữ liệu mới (UserProfileResponse) được trả về Client.
    // Bước 9: Gán kết quả vào biến _profile, hiển thị thông báo "_successMessage".
    // Bước 10: Kết thúc. Dữ liệu mới hiển thị trên form.

    private async Task HandleAvatarChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var maxAllowedSize = 5 * 1024 * 1024; // 5 MB
            if (file.Size > maxAllowedSize)
            {
                _errorMessage = "Kích thước ảnh không được vượt quá 5MB.";
                return;
            }

            try
            {
                _isSubmitting = true;
                _errorMessage = string.Empty;
                
                // Hiển thị preview ảnh (resize và đọc thành base64)
                var format = "image/jpeg";
                var resizedImageFile = await file.RequestImageFileAsync(format, 400, 400);
                using var stream = resizedImageFile.OpenReadStream(maxAllowedSize);
                var buffer = new byte[resizedImageFile.Size];
                await stream.ReadAsync(buffer);
                
                _avatarUrl = $"data:{format};base64,{Convert.ToBase64String(buffer)}";

                // Lưu avatar vào localStorage để giữ khi chuyển trang
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", AvatarLocalStorageKey, _avatarUrl);
                
                // TODO: Gọi API upload file lên server thực tế ở đây
                // var content = new MultipartFormDataContent();
                // content.Add(new ByteArrayContent(buffer), "file", file.Name);
                // await UserApi.UploadAvatarAsync(_session.Email, content);
                
                _successMessage = "Ảnh đại diện đã được cập nhật (Preview)!";
            }
            catch (Exception ex)
            {
                _errorMessage = "Lỗi khi tải ảnh: " + ex.Message;
            }
            finally
            {
                _isSubmitting = false;
            }
        }
    }

    private async Task HandleSubmit()
    {
        if (_session == null) return;

        _isSubmitting = true;
        _errorMessage = string.Empty;
        _successMessage = string.Empty;

        try
        {
            var result = await UserApi.UpdateProfileAsync(_session.Email, _updateModel);
            if (result != null)
            {
                _profile = result;
                _updateModel.CurrentPassword = string.Empty;
                _updateModel.NewPassword = string.Empty;
                
                // Cập nhật lại session nếu user đổi tên
                _session.FullName = result.FullName;
                await SessionService.SaveAsync(new AuthResponse 
                { 
                    Token = _session.Token, 
                    Email = _session.Email, 
                    FullName = _session.FullName, 
                    Role = _session.Role 
                }, true); // default true for simplicty
                
                _successMessage = "Cập nhật thông tin thành công!";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Có lỗi xảy ra: " + ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string GetIconForStyle(string style)
    {
        return style.ToLowerInvariant() switch
        {
            "adventure" => "hiking",
            "cultural" => "local_activity",
            "relaxation" => "spa",
            "luxury" => "diamond",
            _ => "explore"
        };
    }

    private string GetTitleForStyle(string style)
    {
        return style.ToLowerInvariant() switch
        {
            "adventure" => "Tín Đồ Mạo Hiểm (Adventure)",
            "cultural" => "Nhà Khám Phá Văn Hóa (Cultural)",
            "relaxation" => "Chuyên Gia Nghỉ Dưỡng (Relaxation)",
            "luxury" => "Khách Du Lịch Thượng Lưu (Luxury)",
            _ => "Khách du lịch WanderX"
        };
    }

    private string GetDescriptionForStyle(string style)
    {
        return style.ToLowerInvariant() switch
        {
            "adventure" => "Bạn yêu thích những thử thách, leo núi, chèo thuyền, khám phá thiên nhiên hoang dã và không ngại vượt qua giới hạn của bản thân để trải nghiệm những điều mới lạ.",
            "cultural" => "Bạn yêu thích việc tìm hiểu sâu xa lịch sử, ẩm thực và nếp sống của con người bản địa. Bạn thích những chuyến hành trình chậm rãi, giàu chất văn thơ hơn là check-in vội vàng.",
            "relaxation" => "Bạn tìm kiếm sự bình yên, thư thái để tái tạo năng lượng. Những bãi biển cát trắng, spa cao cấp hay nằm đọc sách bên hồ bơi là thiên đường du lịch lý tưởng của bạn.",
            "luxury" => "Bạn trân trọng những dịch vụ đẳng cấp 5 sao, ẩm thực fine-dining độc bản và những trải nghiệm xa xỉ, tinh tế, chăm sóc chu đáo suốt hành trình.",
            _ => "Hệ thống đang phân tích phong cách du lịch của bạn."
        };
    }
}
