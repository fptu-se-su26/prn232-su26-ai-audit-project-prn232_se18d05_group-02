@page "/my-bookings"
@using WanderXClient.Models
@using WanderXClient.Services
@inject UserApiClient UserApi
@inject AuthSessionService SessionService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

<PageTitle>WanderX - My Bookings</PageTitle>

<div class="wx-page-shell">
    <AppHeader />

    @if (_isLoading)
    {
        <main class="wx-page-main">
            <div class="flex justify-center items-center min-h-[60vh]">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 !border-primary"></div>
            </div>
        </main>
    }
    else
    {
        <main class="wx-page-main">
            <div class="max-w-7xl w-full mx-auto px-6 py-12">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">

                    <aside class="lg:col-span-4 bg-white border border-hairline rounded-lg p-6 space-y-6 shadow-sm">
                        <div class="flex flex-col items-center text-center pb-6 border-b border-hairline">
                            <div class="w-20 h-20 rounded-full overflow-hidden border-2 !border-primary mb-4">
                                <img alt="User Avatar Large" class="w-full h-full object-cover" src="@_avatarUrl">
                            </div>
                            <h3 class="font-title font-bold text-lg !text-primary">@_session?.FullName</h3>
                            <span class="text-xs font-semibold text-muted-fg">@_session?.Email</span>

                            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-accent-orange-soft text-accent-orange text-[10px] font-bold uppercase tracking-wider mt-3">
                                <span class="material-symbols-outlined text-[12px]">local_activity</span> Cultural Explorer
                            </span>
                        </div>

                        <nav class="flex flex-col gap-1 text-sm font-semibold text-muted-fg">
                            <a href="my-bookings" class="flex items-center gap-3 px-4 py-3 rounded-lg bg-surface-soft !text-primary">
                                <span class="material-symbols-outlined text-lg">receipt_long</span>
                                My Bookings
                            </a>
                            <a href="service-requests" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-surface-soft hover:!text-primary transition-colors">
                                <span class="material-symbols-outlined text-lg">description</span>
                                Service Requests
                            </a>
                            <a href="profile" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-surface-soft hover:!text-primary transition-colors">
                                <span class="material-symbols-outlined text-lg">person</span>
                                Profile
                            </a>
                            <a href="travel-quiz" class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-surface-soft hover:!text-primary transition-colors">
                                <span class="material-symbols-outlined text-lg">quiz</span>
                                Travel Style Quiz
                            </a>
                        </nav>
                    </aside>

                    <section class="lg:col-span-8 space-y-6">
                        <div class="flex items-center justify-between border-b border-hairline pb-4">
                            <h1 class="text-2xl font-extrabold tracking-tight font-title !text-primary">Booking List</h1>
                            <span class="text-xs font-semibold text-muted-fg">
                                @if (_bookings.Count > 0)
                                {
                                    var start = (_currentPage - 1) * PageSize + 1;
                                    var end = Math.Min(_currentPage * PageSize, _bookings.Count);
                                    <text>Visible @start–@end / @_bookings.Count transactions</text>
                                }
                                else
                                {
                                    <text>0 transactions</text>
                                }
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="bg-red-50 text-red-600 p-4 rounded-lg text-sm border border-red-200">
                                @_errorMessage
                            </div>
                        }

                        @if (_bookings.Count == 0)
                        {
                            <div class="bg-surface-soft border border-hairline rounded-lg p-10 text-center">
                                <span class="material-symbols-outlined text-4xl text-muted-fg mb-3">luggage</span>
                                <h3 class="font-title font-bold text-lg !text-primary">No trips yet</h3>
                                <p class="text-sm text-muted-fg mt-1 mb-4">You have not made any bookings yet.</p>
                                <a href="/" class="inline-flex items-center justify-center bg-primary text-white font-semibold text-sm px-6 py-2.5 rounded-full transition-all">
                                    Explore now
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="space-y-6">
                                @foreach (var booking in PagedBookings)
                                {
                                    var statusStyles = booking.Status switch
                                    {
                                        "Paid" => "bg-green-50 text-green-700 border-green-200",
                                        "Pending" => "bg-amber-50 text-amber-700 border-amber-200",
                                        "Cancelled" => "bg-red-50 text-red-700 border-red-200",
                                        _ => "bg-gray-50 text-gray-700 border-gray-200"
                                    };

                                    var statusText = booking.Status switch
                                    {
                                        "Paid" => "Paid",
                                        "Pending" => "Pending payment",
                                        "Cancelled" => "Cancelled",
                                        _ => booking.Status
                                    };

                                    var cardClasses = booking.Status == "Cancelled"
                                        ? "opacity-75 hover:opacity-100"
                                        : "";

                                    var imgClasses = booking.Status == "Cancelled" ? "grayscale" : "";

                                    <div class="bg-white border border-hairline rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 flex flex-col md:flex-row @cardClasses">
                                        <div class="w-full md:w-48 aspect-[4/3] md:aspect-auto md:h-auto overflow-hidden bg-surface-mid flex-shrink-0 @imgClasses">
                                            <img alt="Thumbnail" class="w-full h-full object-cover" src="@(booking.ThumbnailUrl ?? "/images/placeholder.jpg")">
                                        </div>
                                        <div class="p-6 flex-grow flex flex-col justify-between">
                                            <div>
                                                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                                                    <span class="text-xs text-muted-fg font-semibold">Booking code: <span class="!text-primary font-bold">@booking.BookingCode</span></span>
                                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold border @statusStyles">@statusText</span>
                                                </div>
                                                <h3 class="font-title font-semibold text-base !text-primary leading-snug hover:text-accent-orange transition-colors">
                                                    @booking.TourName
                                                </h3>
                                                <div class="flex gap-4 text-xs font-medium text-muted-fg mt-3">
                                                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">calendar_month</span>Departure: @booking.DepartureDate.ToString("dd/MM/yyyy")</span>
                                                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">group</span>@booking.GuestCount guests</span>
                                                </div>
                                            </div>
                                            <div class="flex items-end justify-between border-t border-hairline pt-4 mt-4">
                                                <div>
                                                    <span class="text-xs text-muted-fg block">Total Payment</span>
                                                    @if (booking.Status == "Cancelled")
                                                    {
                                                        <span class="font-bold text-muted-fg font-title text-base line-through">@booking.TotalAmount.ToString("N0")VND</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="font-bold text-accent-orange font-title text-base">@booking.TotalAmount.ToString("N0")VND</span>
                                                    }
                                                </div>
                                                <div class="flex gap-2">
                                                    @if (CanPayBooking(booking))
                                                    {
                                                        <button type="button" class="inline-flex items-center justify-center bg-accent-orange hover:bg-accent-orange/95 text-white font-semibold text-xs px-4 py-2 rounded-full transition-all shadow-sm" @onclick="() => OpenPaymentModal(booking)">
                                                            Pay now
                                                        </button>
                                                    }
                                                    <a href="/booking-detail/@booking.Id" class="inline-flex items-center justify-center border border-hairline hover:bg-surface-soft !text-primary font-semibold text-xs px-4 py-2 rounded-full transition-all">
                                                        Details
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (TotalPages >= 1)
                            {
                                <div class="flex items-center justify-between pt-4 border-t border-hairline">
                                    <span class="text-xs text-muted-fg">Page @_currentPage / @TotalPages</span>
                                    <div class="flex items-center gap-1">
                                        <button class="wx-page-btn" disabled="@(_currentPage <= 1)" @onclick="PrevPage" title="Previous page">
                                            <span class="material-symbols-outlined text-base">chevron_left</span>
                                        </button>
                                        @for (var p = 1; p <= TotalPages; p++)
                                        {
                                            var pg = p;
                                            <button class="wx-page-btn @(_currentPage == pg ? "wx-page-btn--active" : "")"
                                                    @onclick="() => GoToPage(pg)">@pg</button>
                                        }
                                        <button class="wx-page-btn" disabled="@(_currentPage >= TotalPages)" @onclick="NextPage" title="Next page">
                                            <span class="material-symbols-outlined text-base">chevron_right</span>
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </section>
                </div>
            </div>
        </main>
    }

    @if (_showPaymentModal && _paymentBooking is not null)
    {
        <div class="wx-payment-overlay" @onclick="ClosePaymentModal">
            <section class="wx-payment-modal" @onclick:stopPropagation>
                <button type="button" class="wx-payment-close" title="Close" @onclick="ClosePaymentModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
                <div class="wx-payment-heading">
                    <span>Payment</span>
                    <h2>@_paymentBooking.BookingCode</h2>
                    <p>@_paymentBooking.TourName</p>
                </div>

                <div class="wx-payment-stats">
                    <div>
                        <span>Total amount</span>
                        <strong>@_paymentBooking.TotalAmount.ToString("N0") VND</strong>
                    </div>
                    <div>
                        <span>Already paid</span>
                        <strong>@GetPaidAmount(_paymentBooking).ToString("N0") VND</strong>
                    </div>
                    <div>
                        <span>@GetAmountDueLabel(_paymentBooking)</span>
                        <strong>@GetPaymentAmount(_paymentBooking).ToString("N0") VND</strong>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_paymentError))
                {
                    <div class="wx-payment-alert">@_paymentError</div>
                }

                <form class="wx-payment-form" @onsubmit="SubmitPaymentAsync" @onsubmit:preventDefault>
                    <label>
                        <span>Payment type</span>
                        <select @bind="_paymentForm.PaymentOption">
                            <option value="Full">Full payment</option>
                            @if (GetPaidAmount(_paymentBooking) <= 0m)
                            {
                                <option value="Deposit40">40% deposit</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Payment method</span>
                        <select @bind="_paymentForm.PaymentMethod">
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Card">Card</option>
                            <option value="Cash">Cash</option>
                            <option value="E-Wallet">E-Wallet</option>
                        </select>
                    </label>
                    <label>
                        <span>Reference</span>
                        <input type="text" value="Generated after payment" disabled />
                    </label>
                    <label>
                        <span>Updated by</span>
                        <input type="text" value="@GetPaymentActor()" disabled />
                    </label>
                    <label class="wx-payment-wide">
                        <span>Payment note</span>
                        <textarea maxlength="1000" rows="3" placeholder="Optional note for this payment." @bind="_paymentForm.PaymentNote"></textarea>
                    </label>

                    <div class="wx-payment-actions">
                        <button type="button" class="wx-payment-secondary" @onclick="ClosePaymentModal">Cancel</button>
                        <button type="submit" class="wx-payment-primary" disabled="@_isPaying">
                            <span class="material-symbols-outlined">receipt_long</span>
                            @(_isPaying ? "Saving..." : "Confirm payment")
                        </button>
                    </div>
                </form>
            </section>
        </div>
    }

    @if (_showInvoiceModal && _invoiceBooking is not null)
    {
        <div class="wx-payment-overlay" @onclick="CloseInvoiceModal">
            <section class="wx-invoice-modal" @onclick:stopPropagation>
                <div class="wx-invoice-print" id="booking-invoice">
                    <div class="wx-invoice-top">
                        <div>
                            <span>WanderX receipt</span>
                            <h2>@_invoiceBooking.BookingCode</h2>
                        </div>
                        <button type="button" class="wx-payment-close wx-print-hidden" title="Close" @onclick="CloseInvoiceModal">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                    <dl class="wx-invoice-grid">
                        <div><dt>Tour</dt><dd>@_invoiceBooking.TourName</dd></div>
                        <div><dt>Customer</dt><dd>@_invoiceBooking.CustomerName</dd></div>
                        <div><dt>Departure</dt><dd>@_invoiceBooking.DepartureDate.ToString("dd/MM/yyyy")</dd></div>
                        <div><dt>Guests</dt><dd>@_invoiceBooking.GuestCount</dd></div>
                        <div><dt>Payment type</dt><dd>@FormatPaymentOption(_invoiceBooking.PaymentOption)</dd></div>
                        <div><dt>Method</dt><dd>@(_invoiceBooking.PaymentMethod ?? "N/A")</dd></div>
                        <div><dt>Reference</dt><dd>@(_invoiceBooking.PaymentReference ?? "N/A")</dd></div>
                        <div><dt>Paid at</dt><dd>@((_invoiceBooking.PaymentUpdatedAt ?? _invoiceBooking.PaidAt)?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</dd></div>
                    </dl>
                    <div class="wx-invoice-total">
                        <div><span>Total</span><strong>@(_invoiceBooking.TotalAmount.ToString("N0")) VND</strong></div>
                        <div><span>Paid</span><strong>@((_invoiceBooking.PaidAmount ?? 0m).ToString("N0")) VND</strong></div>
                        <div><span>Remaining</span><strong>@((_invoiceBooking.RemainingAmount ?? 0m).ToString("N0")) VND</strong></div>
                    </div>
                    <p class="wx-invoice-note">Please keep this bill as payment evidence for WanderX staff.</p>
                </div>
                <div class="wx-payment-actions wx-print-hidden">
                    <button type="button" class="wx-payment-secondary" @onclick="CloseInvoiceModal">Close</button>
                    <button type="button" class="wx-payment-primary" @onclick="PrintInvoiceAsync">
                        <span class="material-symbols-outlined">print</span>
                        Print bill
                    </button>
                </div>
            </section>
        </div>
    }

    <AppFooter />
</div>

<style>
    .wx-page-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }
    .wx-page-main {
        flex: 1;
    }
    /* Pagination */
    .wx-page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 34px;
        padding: 0 6px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #0f172a;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s;
    }
    .wx-page-btn:hover:not(:disabled) {
        background: #f1f5f9;
        border-color: #cbd5e1;
    }
    .wx-page-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
    .wx-page-btn--active {
        background: #0f172a !important;
        color: #fff !important;
        border-color: #0f172a !important;
    }
    .wx-payment-overlay {
        position: fixed;
        inset: 0;
        z-index: 80;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(15, 23, 42, 0.48);
        backdrop-filter: blur(8px);
    }
    .wx-payment-modal,
    .wx-invoice-modal {
        position: relative;
        width: min(920px, 100%);
        max-height: min(90vh, 820px);
        overflow: auto;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        background: #fff;
        box-shadow: 0 24px 70px rgba(15, 23, 42, 0.22);
    }
    .wx-payment-modal {
        padding: 28px;
    }
    .wx-payment-close {
        position: absolute;
        top: 18px;
        right: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 999px;
        background: #f8fafc;
        color: #64748b;
        cursor: pointer;
    }
    .wx-payment-heading span,
    .wx-payment-stats span,
    .wx-payment-form span,
    .wx-invoice-top span,
    .wx-invoice-total span {
        display: block;
        color: #64748b;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
    }
    .wx-payment-heading h2 {
        margin: 4px 0 2px;
        color: #0f172a;
        font-size: 28px;
        font-weight: 800;
    }
    .wx-payment-heading p {
        margin: 0;
        color: #64748b;
        font-weight: 600;
    }
    .wx-payment-stats,
    .wx-invoice-total {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin: 24px 0;
    }
    .wx-payment-stats div,
    .wx-invoice-total div {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #f8fafc;
        padding: 14px;
    }
    .wx-payment-stats strong,
    .wx-invoice-total strong {
        display: block;
        margin-top: 6px;
        color: #0f172a;
        font-size: clamp(18px, 2.2vw, 24px);
        line-height: 1.1;
        overflow-wrap: anywhere;
    }
    .wx-payment-form {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px 18px;
    }
    .wx-payment-form label {
        display: grid;
        gap: 8px;
    }
    .wx-payment-form input,
    .wx-payment-form select,
    .wx-payment-form textarea {
        width: 100%;
        min-height: 46px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 10px 12px;
        color: #0f172a;
        background: #fff;
        font: inherit;
    }
    .wx-payment-form input:disabled {
        background: #f8fafc;
        color: #64748b;
    }
    .wx-payment-wide {
        grid-column: 1 / -1;
    }
    .wx-payment-alert {
        margin: 18px 0;
        border: 1px solid #fecdd3;
        border-radius: 8px;
        background: #fff1f2;
        color: #be123c;
        padding: 12px 14px;
        font-size: 14px;
        font-weight: 700;
    }
    .wx-payment-actions {
        grid-column: 1 / -1;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 8px;
    }
    .wx-payment-primary,
    .wx-payment-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        border-radius: 999px;
        padding: 0 20px;
        font-weight: 800;
        cursor: pointer;
    }
    .wx-payment-primary {
        border: 1px solid #ff5a5f;
        background: #ff5a5f;
        color: #fff;
    }
    .wx-payment-primary:disabled {
        opacity: 0.6;
        cursor: wait;
    }
    .wx-payment-secondary {
        border: 1px solid #cbd5e1;
        background: #fff;
        color: #0f172a;
    }
    .wx-invoice-modal {
        padding: 0;
    }
    .wx-invoice-print {
        padding: 30px;
    }
    .wx-invoice-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 18px;
    }
    .wx-invoice-top h2 {
        margin: 4px 0 0;
        color: #0f172a;
        font-size: 30px;
        font-weight: 900;
    }
    .wx-invoice-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin: 24px 0;
    }
    .wx-invoice-grid div {
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 10px;
    }
    .wx-invoice-grid dt {
        color: #64748b;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
    }
    .wx-invoice-grid dd {
        margin: 4px 0 0;
        color: #0f172a;
        font-weight: 700;
    }
    .wx-invoice-note {
        margin: 8px 0 0;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
    }
    @@media (max-width: 720px) {
        .wx-payment-overlay {
            padding: 12px;
            align-items: flex-start;
        }
        .wx-payment-modal {
            padding: 22px 16px;
        }
        .wx-payment-form,
        .wx-payment-stats,
        .wx-invoice-grid,
        .wx-invoice-total {
            grid-template-columns: 1fr;
        }
        .wx-payment-actions {
            flex-direction: column-reverse;
        }
        .wx-payment-primary,
        .wx-payment-secondary {
            width: 100%;
        }
    }
    @@media print {
        body * {
            visibility: hidden !important;
        }
        .wx-invoice-print,
        .wx-invoice-print * {
            visibility: visible !important;
        }
        .wx-invoice-print {
            position: fixed;
            inset: 0;
            padding: 24px;
            background: #fff;
        }
        .wx-print-hidden {
            display: none !important;
        }
    }
</style>

@code {
    private const int PageSize = 5;
    private int _currentPage = 1;

    private bool _isLoading = true;
    private string _errorMessage = string.Empty;
    private AuthSession? _session;
    private List<BookingSummaryResponse> _bookings = new();
    private string _avatarUrl = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=200";
    private bool _showPaymentModal;
    private bool _showInvoiceModal;
    private bool _isPaying;
    private string? _paymentError;
    private BookingSummaryResponse? _paymentBooking;
    private BookingResponse? _invoiceBooking;
    private CustomerPaymentForm _paymentForm = new();

    private int TotalPages => (int)Math.Ceiling(_bookings.Count / (double)PageSize);
    private IEnumerable<BookingSummaryResponse> PagedBookings =>
        _bookings.Skip((_currentPage - 1) * PageSize).Take(PageSize);

    private void GoToPage(int page) { _currentPage = page; }
    private void PrevPage() { if (_currentPage > 1) _currentPage--; }
    private void NextPage() { if (_currentPage < TotalPages) _currentPage++; }

    private void OpenPaymentModal(BookingSummaryResponse booking)
    {
        _paymentBooking = booking;
        _invoiceBooking = null;
        _paymentError = null;
        _paymentForm = new CustomerPaymentForm
        {
            PaymentOption = "Full",
            PaymentMethod = "Bank Transfer"
        };
        _showPaymentModal = true;
    }

    private void ClosePaymentModal()
    {
        if (_isPaying)
        {
            return;
        }

        _showPaymentModal = false;
        _paymentBooking = null;
        _paymentError = null;
    }

    private void CloseInvoiceModal()
    {
        _showInvoiceModal = false;
        _invoiceBooking = null;
    }

    private async Task SubmitPaymentAsync()
    {
        if (_paymentBooking is null)
        {
            return;
        }

        _paymentError = null;

        _isPaying = true;
        try
        {
            var updated = await UserApi.UpdatePaymentAsync(_paymentBooking.Id, new UpdatePaymentRequest
            {
                PaymentOption = _paymentForm.PaymentOption,
                PaymentMethod = _paymentForm.PaymentMethod,
                PaymentReference = null,
                UpdatedBy = GetPaymentActor(),
                PaymentNote = _paymentForm.PaymentNote
            });

            if (updated is null)
            {
                _paymentError = "Payment could not be recorded. Please try again.";
                return;
            }

            _invoiceBooking = updated;
            _showPaymentModal = false;
            _showInvoiceModal = true;
            await ReloadBookingsAsync();
        }
        catch (Exception ex)
        {
            _paymentError = ex.Message;
        }
        finally
        {
            _isPaying = false;
        }
    }

    private Task PrintInvoiceAsync()
    {
        return JSRuntime.InvokeVoidAsync("window.print").AsTask();
    }

    private string GetPaymentActor()
    {
        return _session?.FullName ?? _session?.Email ?? "Customer";
    }

    private static decimal GetPaidAmount(BookingSummaryResponse booking)
    {
        return booking.PaidAmount ?? 0m;
    }

    private static decimal GetRemainingAmount(BookingSummaryResponse booking)
    {
        return booking.RemainingAmount ?? booking.TotalAmount;
    }

    private static bool CanPayBooking(BookingSummaryResponse booking)
    {
        if (booking.Status is "Cancelled" or "Finished" or "Confirmed")
        {
            return false;
        }

        return !booking.PaidAt.HasValue || GetRemainingAmount(booking) > 0m;
    }

    private decimal GetPaymentAmount(BookingSummaryResponse booking)
    {
        return _paymentForm.PaymentOption switch
        {
            "Deposit40" => decimal.Round(booking.TotalAmount * 0.4m, 2, MidpointRounding.AwayFromZero),
            _ => GetPaidAmount(booking) > 0m ? GetRemainingAmount(booking) : booking.TotalAmount
        };
    }

    private static string GetAmountDueLabel(BookingSummaryResponse booking)
    {
        return GetPaidAmount(booking) > 0m ? "Remaining balance" : "Payment now";
    }

    private static string FormatPaymentOption(string? option)
    {
        return option switch
        {
            "Deposit40" => "40% deposit",
            "Full" => "Full payment",
            _ => option ?? "N/A"
        };
    }

    private async Task ReloadBookingsAsync()
    {
        if (_session is null)
        {
            return;
        }

        var result = await UserApi.GetBookingsAsync(_session.Email);
        if (result != null)
        {
            _bookings = result.ToList();
            if (_currentPage > TotalPages)
            {
                _currentPage = Math.Max(TotalPages, 1);
            }
        }
    }


    protected override async Task OnInitializedAsync()
    {
        _session = await SessionService.GetAsync();

        if (_session == null)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        try
        {
            var savedAvatar = await JSRuntime.InvokeAsync<string>("localStorage.getItem", $"avatar_{_session.Email}");
            if (!string.IsNullOrEmpty(savedAvatar))
            {
                _avatarUrl = savedAvatar;
            }

            await ReloadBookingsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = "Could not load bookings: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                (function() {
                    if (document.getElementById('tailwind-cdn')) return;
                    var script = document.createElement('script');
                    script.id = 'tailwind-cdn';
                    script.src = 'https://cdn.tailwindcss.com?plugins=forms,container-queries';
                    script.onload = function() {
                        tailwind.config = {
                            corePlugins: { preflight: false },
                            darkMode: 'class',
                            theme: {
                                extend: {
                                    colors: {
                                        primary: '#0f172a', 'on-primary': '#ffffff', canvas: '#ffffff',
                                        'surface-soft': '#f8fafc', 'surface-mid': '#f1f5f9', hairline: '#e2e8f0',
                                        'muted-fg': '#64748b', 'accent-orange': '#ff5a5f',
                                        'on-accent-orange': '#ffffff', 'accent-orange-soft': '#fff1f2'
                                    },
                                    fontFamily: {
                                        title: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
                                        body: ['Inter', 'sans-serif']
                                    }
                                }
                            }
                        };
                    };
                    document.head.appendChild(script);
                })();
            ");
        }
    }

    private sealed class CustomerPaymentForm
    {
        public string PaymentOption { get; set; } = "Full";
        public string PaymentMethod { get; set; } = "Bank Transfer";
        public string? PaymentNote { get; set; }
    }
}
