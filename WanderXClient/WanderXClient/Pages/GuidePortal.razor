@code {
    private const string PortalTabCalendar = "Calendar";
    private const string PortalTabTours = "Tours";
    private const string PortalTabDetail = "Detail";
    private string _activePortalTab = PortalTabCalendar;

    private const int MaxEventsPerDay = 3;
    private static readonly string[] CalendarWeekdays = new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
    private static readonly string[] CalendarLegendStatuses = new[] { "Assigned", "Confirmed", "Finished", "Declined" };
    private static readonly string[] StatusFilterOptions = new[] { "All", "Assigned", "Confirmed", "Finished", "Declined" };

    private readonly DeclineTourRequest _declineModel = new();
    private List<GuideTourAssignmentResponse> _assignments = new();
    private GuideTourAssignmentResponse? _selectedAssignment;
    private DateTime _visibleMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _selectedDateFilter;
    private bool _isLoading;
    private bool _isSaving;
    private bool _isError;
    private bool _scheduleLoaded;
    private bool _isDeclinePanelOpen;
    private bool _isFinishModalOpen;
    private string? _evidenceImageBase64;
    private bool _isCameraActive;
    private string _activeTab = "upload";
    private string? _cameraError;
    private bool _requiresLogin;
    private bool _accessDenied;
    private bool _calendarMonthInitialized;
    private Guid? _pendingScrollAssignmentId;
    private string _guideEmail = string.Empty;
    private string _guideName = string.Empty;
    private string? _message;

    private bool HasGuideSession => !_requiresLogin && !_accessDenied && !string.IsNullOrWhiteSpace(_guideEmail);

    private string GuideAvailability => _assignments.Any(item => item.IsCurrentBusyTour) ? "Busy" : "Available";

    private string _statusFilter = "All";

    private string DateFilterInputValue => _selectedDateFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthSession.GetAsync();

        if (session is null)
        {
            _requiresLogin = true;
            _isError = true;
            _message = "Please sign in with a guide account to view your schedule.";
            return;
        }

        if (!session.IsGuide)
        {
            _accessDenied = true;
            _isError = true;
            _message = "Only guide accounts can view the guide portal schedule.";
            return;
        }

        if (string.IsNullOrWhiteSpace(session.Email))
        {
            _requiresLogin = true;
            _isError = true;
            _message = "Your login session does not include an email. Please sign in again.";
            return;
        }

        _guideEmail = session.Email.Trim();
        _guideName = string.IsNullOrWhiteSpace(session.FullName) ? "Guide account" : session.FullName.Trim();
        await LoadScheduleAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingScrollAssignmentId is not Guid assignmentId)
        {
            return;
        }

        _pendingScrollAssignmentId = null;
        await JsRuntime.InvokeVoidAsync("wanderX.scrollToElement", GetUpcomingAssignmentElementId(assignmentId));
    }

    private async Task LoadScheduleAsync()
    {
        if (!HasGuideSession)
        {
            return;
        }

        _isLoading = true;
        _isError = false;
        _message = null;
        _selectedAssignment = null;
        _isDeclinePanelOpen = false;

        try
        {
            _assignments = await GuideTourApi.GetScheduleAsync(_guideEmail);
            InitializeCalendarMonth();
            _selectedAssignment = _assignments.FirstOrDefault(item =>
                item.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) ||
                item.Status.Equals("Assigned", StringComparison.OrdinalIgnoreCase)) ?? _assignments.FirstOrDefault();
            _scheduleLoaded = true;
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ToUserMessage(ex);
            _scheduleLoaded = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectAssignment(GuideTourAssignmentResponse assignment)
    {
        _selectedAssignment = assignment;
        _declineModel.Reason = string.Empty;
        _isDeclinePanelOpen = false;
        _message = null;
        _isError = false;
        _activePortalTab = PortalTabDetail;
    }

    private void SelectCalendarAssignment(GuideTourAssignmentResponse assignment)
    {
        SelectAssignment(assignment);
        _selectedDateFilter = null;
        _pendingScrollAssignmentId = assignment.Id;
    }

    private void ToggleDeclinePanel()
    {
        _isDeclinePanelOpen = !_isDeclinePanelOpen;
    }

    private async Task DeclineSelectedAsync()
    {
        if (_selectedAssignment is null)
        {
            return;
        }

        _isSaving = true;
        _message = null;
        _isError = false;

        try
        {
            var updated = await GuideTourApi.DeclineAsync(_selectedAssignment.Id, _declineModel);
            _message = "Tour decline request has been submitted.";
            _isDeclinePanelOpen = false;
            _declineModel.Reason = string.Empty;
            await RefreshUpdatedAssignmentAsync(updated);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ToUserMessage(ex);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenFinishModal()
    {
        _isFinishModalOpen = true;
        _evidenceImageBase64 = null;
        _activeTab = "upload";
        _cameraError = null;
        _isCameraActive = false;
    }

    private async Task CloseFinishModalAsync()
    {
        if (_isCameraActive)
        {
            await StopCameraAsync();
        }
        _isFinishModalOpen = false;
    }

    private async Task SelectTabAsync(string tab)
    {
        _activeTab = tab;
        if (tab == "camera")
        {
            await StartCameraAsync();
        }
        else
        {
            await StopCameraAsync();
        }
    }

    private async Task StartCameraAsync()
    {
        _cameraError = null;
        _isCameraActive = true;
        StateHasChanged();
        await Task.Delay(100);
        bool success = await JsRuntime.InvokeAsync<bool>("wanderXCamera.startCamera", "evidence-video");
        if (!success)
        {
            _cameraError = "Không thể truy cập camera. Vui lòng cấp quyền camera hoặc tải ảnh lên.";
            _isCameraActive = false;
        }
    }

    private async Task StopCameraAsync()
    {
        _isCameraActive = false;
        await JsRuntime.InvokeVoidAsync("wanderXCamera.stopCamera", "evidence-video");
    }

    private async Task CapturePhotoAsync()
    {
        if (!_isCameraActive) return;
        var capturedData = await JsRuntime.InvokeAsync<string>("wanderXCamera.captureFrame", "evidence-video");
        if (!string.IsNullOrEmpty(capturedData))
        {
            _evidenceImageBase64 = capturedData;
            await StopCameraAsync();
        }
    }

    private async Task RetakePhotoAsync()
    {
        _evidenceImageBase64 = null;
        await StartCameraAsync();
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is not null)
        {
            var format = file.ContentType;
            if (format.StartsWith("image/"))
            {
                try
                {
                    var resizedImage = await file.RequestImageFileAsync(format, 800, 800);
                    using var stream = resizedImage.OpenReadStream(1024 * 1024 * 5); // 5MB max
                    using var memoryStream = new System.IO.MemoryStream();
                    await stream.CopyToAsync(memoryStream);
                    var buffer = memoryStream.ToArray();
                    _evidenceImageBase64 = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
                }
                catch (Exception ex)
                {
                    _message = "Lỗi khi tải ảnh: " + ex.Message;
                    _isError = true;
                }
            }
            else
            {
                _message = "Vui lòng chọn tệp ảnh hợp lệ.";
                _isError = true;
            }
        }
    }

    private async Task ConfirmFinishTourAsync()
    {
        if (string.IsNullOrEmpty(_evidenceImageBase64) || _selectedAssignment is null)
        {
            return;
        }

        _isSaving = true;
        _message = null;
        _isError = false;

        try
        {
            var request = new FinishTourRequest { EvidenceImage = _evidenceImageBase64 };
            var updated = await GuideTourApi.FinishAsync(_selectedAssignment.Id, request);
            _message = "Tour has been marked as finished.";
            await RefreshUpdatedAssignmentAsync(updated);
            await CloseFinishModalAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ToUserMessage(ex);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task RefreshUpdatedAssignmentAsync(GuideTourAssignmentResponse? updated)
    {
        if (updated is null)
        {
            await LoadScheduleAsync();
            return;
        }

        var index = _assignments.FindIndex(item => item.Id == updated.Id);

        if (index >= 0)
        {
            _assignments[index] = updated;
        }

        _selectedAssignment = updated;
        _assignments = await GuideTourApi.GetScheduleAsync(_guideEmail);
        _selectedAssignment = _assignments.FirstOrDefault(item => item.Id == updated.Id) ?? updated;
    }

    private List<CalendarDayCell> GetCalendarDays()
    {
        var firstDayOfMonth = new DateTime(_visibleMonth.Year, _visibleMonth.Month, 1);
        var gridStart = firstDayOfMonth.AddDays(-(int)firstDayOfMonth.DayOfWeek);

        return Enumerable.Range(0, 42)
            .Select(index =>
            {
                var date = gridStart.AddDays(index).Date;
                var assignments = GetCalendarAssignments()
                    .Where(item => IsAssignmentOnDate(item, date))
                    .OrderBy(item => item.StartDate)
                    .ThenBy(item => item.EndDate)
                    .ToList();

                return new CalendarDayCell
                {
                    Date = date,
                    IsCurrentMonth = date.Month == _visibleMonth.Month,
                    IsToday = date == DateTime.Today,
                    Assignments = assignments
                };
            })
            .ToList();
    }

    private List<GuideTourAssignmentResponse> GetUpcomingAssignments()
    {
        var today = DateTime.Today;

        var orderedAssignments = GetCalendarAssignments()
            .Where(MatchesDateFilter)
            .OrderBy(item => item.EndDate.Date < today ? 1 : 0)
            .ThenBy(item => item.StartDate)
            .ThenBy(item => item.TourName)
            .ToList();
        var visibleAssignments = orderedAssignments.Take(6).ToList();

        if (_selectedAssignment is not null && visibleAssignments.All(item => item.Id != _selectedAssignment.Id))
        {
            var selectedAssignment = orderedAssignments.FirstOrDefault(item => item.Id == _selectedAssignment.Id);

            if (selectedAssignment is not null)
            {
                visibleAssignments.Add(selectedAssignment);
            }
        }

        return visibleAssignments;
    }

    private int GetVisibleMonthTourCount()
    {
        return GetCalendarAssignments().Count(IsAssignmentVisibleInMonth);
    }

    private void ShowPreviousMonth()
    {
        _visibleMonth = _visibleMonth.AddMonths(-1);
    }

    private void ShowNextMonth()
    {
        _visibleMonth = _visibleMonth.AddMonths(1);
    }

    private void ShowCurrentMonth()
    {
        var today = DateTime.Today;
        _visibleMonth = new DateTime(today.Year, today.Month, 1);
    }

    private void InitializeCalendarMonth()
    {
        if (_calendarMonthInitialized)
        {
            return;
        }

        var anchorAssignment = _assignments.FirstOrDefault(item => item.IsCurrentBusyTour)
            ?? _assignments
                .Where(item => item.EndDate.Date >= DateTime.Today)
                .OrderBy(item => item.StartDate)
                .FirstOrDefault()
            ?? _assignments
                .OrderByDescending(item => item.StartDate)
                .FirstOrDefault();

        var anchorDate = anchorAssignment?.StartDate.Date ?? DateTime.Today;
        _visibleMonth = new DateTime(anchorDate.Year, anchorDate.Month, 1);
        _calendarMonthInitialized = true;
    }

    private bool IsAssignmentVisibleInMonth(GuideTourAssignmentResponse assignment)
    {
        var monthStart = new DateTime(_visibleMonth.Year, _visibleMonth.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);

        return assignment.StartDate.Date <= monthEnd && assignment.EndDate.Date >= monthStart;
    }

    private static bool IsAssignmentOnDate(GuideTourAssignmentResponse assignment, DateTime date)
    {
        return assignment.StartDate.Date <= date.Date && assignment.EndDate.Date >= date.Date;
    }

    private IEnumerable<GuideTourAssignmentResponse> GetCalendarAssignments()
    {
        return _assignments.Where(MatchesStatusFilter);
    }

    private bool MatchesStatusFilter(GuideTourAssignmentResponse assignment)
    {
        return _statusFilter.Equals("All", StringComparison.OrdinalIgnoreCase) ||
            assignment.Status.Equals(_statusFilter, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesDateFilter(GuideTourAssignmentResponse assignment)
    {
        return _selectedDateFilter is not DateTime selectedDate ||
            IsAssignmentOnDate(assignment, selectedDate);
    }

    private void SetStatusFilter(string status)
    {
        _statusFilter = status;

        if (_selectedAssignment is not null && !MatchesStatusFilter(_selectedAssignment))
        {
            _selectedAssignment = null;
            _isDeclinePanelOpen = false;
        }
    }

    private void ToggleDateFilter(DateTime date)
    {
        _selectedDateFilter = _selectedDateFilter?.Date == date.Date ? null : date.Date;

        if (_selectedAssignment is not null && !MatchesDateFilter(_selectedAssignment))
        {
            _selectedAssignment = null;
            _isDeclinePanelOpen = false;
        }

        if (_selectedDateFilter is not null)
        {
            _activePortalTab = PortalTabTours;
        }
    }

    private void OnDatePickerChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();

        if (string.IsNullOrWhiteSpace(value))
        {
            ClearDateFilter();
            return;
        }

        if (!DateTime.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var selectedDate))
        {
            return;
        }

        _selectedDateFilter = selectedDate.Date;
        _visibleMonth = new DateTime(selectedDate.Year, selectedDate.Month, 1);
        _activePortalTab = PortalTabTours;

        if (_selectedAssignment is not null && !MatchesDateFilter(_selectedAssignment))
        {
            _selectedAssignment = null;
            _isDeclinePanelOpen = false;
        }
    }

    private void ClearDateFilter()
    {
        _selectedDateFilter = null;
    }

    private string GetPortalTabClass(string tab)
    {
        return _activePortalTab == tab
            ? "guide-portal-tab guide-portal-tab--active"
            : "guide-portal-tab";
    }

    private void SetPortalTab(string tab)
    {
        _activePortalTab = tab;
