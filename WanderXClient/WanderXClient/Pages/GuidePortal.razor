            "assigned" => "guide-status guide-status--active",
            "finished" => "guide-status guide-status--muted",
            "declined" => "guide-status guide-status--busy",
            _ => "guide-status"
        };
    }

    private string GetCalendarDayClass(CalendarDayCell day)
    {
        var cssClass = "guide-calendar-day";

        if (!day.IsCurrentMonth)
        {
            cssClass += " guide-calendar-day--outside";
        }

        if (day.IsToday)
        {
            cssClass += " guide-calendar-day--today";
        }

        if (_selectedAssignment is not null && IsAssignmentOnDate(_selectedAssignment, day.Date))
        {
            cssClass += " guide-calendar-day--selected";
        }

        if (day.Assignments.Any(item => item.IsCurrentBusyTour))
        {
            cssClass += " guide-calendar-day--busy";
        }

        if (_selectedDateFilter?.Date == day.Date)
        {
            cssClass += " guide-calendar-day--filtered";
        }

        return cssClass;
    }

    private string GetStatusFilterClass(string status)
    {
        return _statusFilter.Equals(status, StringComparison.OrdinalIgnoreCase)
            ? "guide-filter guide-filter--active"
            : "guide-filter";
