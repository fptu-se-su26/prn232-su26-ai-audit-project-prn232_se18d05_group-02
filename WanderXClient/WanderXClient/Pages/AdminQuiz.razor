</style>

@code {
    private List<QuizQuestionClientDto>? _questions;
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;

    private bool _showModal = false;
    private bool _isEditMode = false;
    private QuizQuestionClientDto _editQuestion = CreateEmptyQuestion();

    private bool _showDeleteConfirm = false;
    private QuizQuestionClientDto? _questionToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadQuestionsAsync();
    }

    private async Task LoadQuestionsAsync()
    {
        _isLoading = true;
        _errorMessage = string.Empty;
        StateHasChanged();
        try
        {
            var result = await ApiClient.GetQuizQuestionsAsync();
            _questions = result?.ToList() ?? new List<QuizQuestionClientDto>();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load questions: {ex.Message}";
            _questions = new List<QuizQuestionClientDto>();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowAddModal()
    {
        _isEditMode = false;
        _editQuestion = CreateEmptyQuestion();
        _showModal = true;
        ClearMessages();
    }

    private void ShowEditModal(QuizQuestionClientDto q)
    {
        _isEditMode = true;
        // Deep copy to avoid mutating list directly
        _editQuestion = new QuizQuestionClientDto
        {
            Id = q.Id,
            Text = q.Text,
            DisplayOrder = q.DisplayOrder,
            Options = q.Options.Select(o => new QuizOptionClientDto
            {
                Id = o.Id,
                QuestionId = o.QuestionId,
                OptionKey = o.OptionKey,
                Text = o.Text,
                Category = o.Category,
                Score = o.Score
            }).ToList()
        };
        _showModal = true;
        ClearMessages();
    }

    private void HideModal() => _showModal = false;

    private void AddOption()
    {
        _editQuestion.Options.Add(new QuizOptionClientDto
        {
            OptionKey = GetNextOptionKey(),
            Score = 3
        });
    }

    private string GetNextOptionKey()
    {
        var keys = new[] { "A", "B", "C", "D", "E", "F" };
        var used = _editQuestion.Options.Select(o => o.OptionKey.ToUpperInvariant()).ToHashSet();
        return keys.FirstOrDefault(k => !used.Contains(k)) ?? "X";
    }

    private void RemoveOption(int idx)
    {
        if (idx >= 0 && idx < _editQuestion.Options.Count)
            _editQuestion.Options.RemoveAt(idx);
    }

    private async Task SaveQuestion()
    {
        ClearMessages();
        if (string.IsNullOrWhiteSpace(_editQuestion.Text))
        {
            _errorMessage = "Question text is required.";
            return;
        }
        if (_editQuestion.Options.Count == 0)
        {
            _errorMessage = "At least one option is required.";
            return;
        }
        foreach (var opt in _editQuestion.Options)
        {
            if (string.IsNullOrWhiteSpace(opt.OptionKey) || string.IsNullOrWhiteSpace(opt.Text) || string.IsNullOrWhiteSpace(opt.Category))
            {
                _errorMessage = "All options must have a key, text, and category.";
                return;
            }
        }

        _isSaving = true;
        try
        {
            if (_isEditMode)
            {
                await ApiClient.UpdateQuizQuestionAsync(_editQuestion.Id, _editQuestion);
                _successMessage = "Question updated successfully.";
            }
            else
            {
                await ApiClient.CreateQuizQuestionAsync(_editQuestion);
                _successMessage = "Question created successfully.";
            }
            _showModal = false;
            await LoadQuestionsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Save failed: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ConfirmDelete(QuizQuestionClientDto q)
    {
        _questionToDelete = q;
        _showDeleteConfirm = true;
        ClearMessages();
    }

    private async Task ExecuteDelete()
    {
        if (_questionToDelete is null) return;
        _isSaving = true;
        try
        {
            await ApiClient.DeleteQuizQuestionAsync(_questionToDelete.Id);
            _successMessage = "Question deleted successfully.";
            _showDeleteConfirm = false;
            _questionToDelete = null;
            await LoadQuestionsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Delete failed: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ClearMessages()
    {
        _errorMessage = string.Empty;
        _successMessage = string.Empty;
    }

    private static QuizQuestionClientDto CreateEmptyQuestion()
    {
        return new QuizQuestionClientDto
        {
            Options = new List<QuizOptionClientDto>
            {
                new QuizOptionClientDto { OptionKey = "A", Score = 3 },
                new QuizOptionClientDto { OptionKey = "B", Score = 3 },
                new QuizOptionClientDto { OptionKey = "C", Score = 3 },
                new QuizOptionClientDto { OptionKey = "D", Score = 3 }
            }
        };
    }
}
