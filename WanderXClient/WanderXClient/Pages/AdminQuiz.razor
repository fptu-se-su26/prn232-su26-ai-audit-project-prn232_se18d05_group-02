@page "/admin-quiz"
@using WanderXClient.Models
@using WanderXClient.Services
@inject UserApiClient ApiClient
@inject IJSRuntime JS

<PageTitle>Manage Quizzes - WanderX Admin</PageTitle>

<div class="guide-admin-page">
    <aside class="guide-sidebar">
        <div class="guide-sidebar__brand">
            <a class="brand-mark" href="/">WanderX</a>
            <p>Admin Suite</p>
        </div>
        <nav class="guide-sidebar__nav" aria-label="Admin navigation">
            <a class="guide-sidebar__link" href="/dashboard">
                <MaterialIcon Name="dashboard" />
                Dashboard
            </a>
            <a class="guide-sidebar__link" href="/guides">
                <MaterialIcon Name="badge" />
                Guides
            </a>
            <a class="guide-sidebar__link" href="/guide-assignments">
                <MaterialIcon Name="assignment_ind" />
                Assignments
            </a>
            <a class="guide-sidebar__link" href="/admin-service-requests">
                <MaterialIcon Name="support_agent" />
                Service Requests
            </a>
            <a class="guide-sidebar__link" href="/tour-reviews">
                <MaterialIcon Name="rate_review" />
                Tour Reviews
            </a>
            <a class="guide-sidebar__link active" href="/admin-quiz" aria-current="page">
                <MaterialIcon Name="quiz" />
                Manage Quizzes
            </a>
            <a class="guide-sidebar__link" href="/">
                <MaterialIcon Name="home" />
                Homepage
            </a>
        </nav>
    </aside>

    <main class="guide-main">
        <header class="guide-topbar">
            <div>
                <p class="guide-eyebrow">Admin</p>
                <h1>Manage Travel Style Quiz</h1>
                <p class="guide-subtitle">Add, edit, and remove quiz questions and their scoring options.</p>
            </div>
            <button class="wx-button" @onclick="ShowAddModal">
                <MaterialIcon Name="add_circle" />
                Add Question
            </button>
        </header>

        <section class="guide-content">
            @if (_isLoading)
            {
                <div class="aqz-loading">
                    <span class="material-symbols-outlined aqz-spinner">progress_activity</span>
                    <p>Loading questions…</p>
                </div>
            }
            else if (_questions is { Count: 0 })
            {
                <div class="aqz-empty">
                    <span class="material-symbols-outlined">quiz</span>
                    <h3>No questions yet</h3>
                    <p>Click "Add Question" to create the first quiz question.</p>
                </div>
            }
            else
            {
                <div class="aqz-question-list">
                    @foreach (var q in _questions!)
                    {
                        <article class="aqz-question-card">
                            <div class="aqz-question-card__header">
                                <div class="aqz-question-card__meta">
                                    <span class="aqz-order-badge">Q@(q.DisplayOrder)</span>
                                    <h3 class="aqz-question-text">@q.Text</h3>
                                </div>
                                <div class="aqz-question-card__actions">
                                    <button class="wx-button wx-button--secondary wx-button--sm" @onclick="() => ShowEditModal(q)">
                                        <MaterialIcon Name="edit" />
                                        Edit
                                    </button>
                                    <button class="wx-button wx-button--danger wx-button--sm" @onclick="() => ConfirmDelete(q)">
                                        <MaterialIcon Name="delete" />
                                        Delete
                                    </button>
                                </div>
                            </div>
                            <div class="aqz-options-grid">
                                @foreach (var opt in q.Options)
                                {
                                    <div class="aqz-option-chip aqz-option-chip--@opt.Category.ToLower()">
                                        <span class="aqz-option-chip__key">@opt.OptionKey</span>
                                        <span class="aqz-option-chip__text">@opt.Text</span>
                                        <span class="aqz-option-chip__cat">@opt.Category</span>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="aqz-toast aqz-toast--error">
                    <MaterialIcon Name="error" />
                    @_errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="aqz-toast aqz-toast--success">
                    <MaterialIcon Name="check_circle" />
                    @_successMessage
                </div>
            }
        </section>
    </main>
    <MobileBottomNav />
</div>

<!-- Add / Edit Modal -->
@if (_showModal)
{
    <div class="aqz-modal-backdrop" @onclick="HideModal">
        <div class="aqz-modal" @onclick:stopPropagation>
            <div class="aqz-modal__header">
                <h2>@(_isEditMode ? "Edit Question" : "Add New Question")</h2>
                <button class="aqz-modal__close" @onclick="HideModal">
                    <MaterialIcon Name="close" />
                </button>
            </div>
            <div class="aqz-modal__body">
                <!-- Question Text -->
                <label class="aqz-field-label" for="q-text">Question Text <span class="aqz-required">*</span></label>
                <textarea id="q-text" class="aqz-textarea" rows="3"
                          placeholder="e.g. Bạn thích đi du lịch đến đâu nhất?"
                          @bind="_editQuestion.Text" @bind:event="oninput"></textarea>

                <!-- Options -->
                <div class="aqz-options-section">
                    <h4>Answer Options</h4>
                    <p class="aqz-hint">Each option maps answers to a travel style category.</p>
                    @for (int i = 0; i < _editQuestion.Options.Count; i++)
                    {
                        var idx = i;
                        var opt = _editQuestion.Options[idx];
                        <div class="aqz-option-editor">
                            <div class="aqz-option-editor__key">
                                <input class="aqz-input aqz-input--sm" maxlength="1"
                                       placeholder="A"
                                       value="@opt.OptionKey"
                                       @oninput="e => opt.OptionKey = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div class="aqz-option-editor__body">
                                <input class="aqz-input" placeholder="Option text…"
                                       value="@opt.Text"
                                       @oninput="e => opt.Text = e.Value?.ToString() ?? string.Empty" />
                                <select class="aqz-select" value="@opt.Category"
                                        @onchange="e => opt.Category = e.Value?.ToString() ?? string.Empty">
                                    <option value="">— Select Category —</option>
                                    <option value="Adventure">🧗 Adventure (Mạo hiểm)</option>
                                    <option value="Cultural">🏛️ Cultural (Văn hóa)</option>
                                    <option value="Relaxation">🏖️ Relaxation (Nghỉ dưỡng)</option>
                                    <option value="Luxury">💎 Luxury (Thượng lưu)</option>
                                </select>
                            </div>
                            <button class="aqz-remove-opt" @onclick="() => RemoveOption(idx)">
                                <MaterialIcon Name="remove_circle" />
                            </button>
                        </div>
                    }
                    <button class="wx-button wx-button--ghost" @onclick="AddOption">
                        <MaterialIcon Name="add" />
                        Add Option
                    </button>
                </div>
            </div>
            <div class="aqz-modal__footer">
                <button class="wx-button wx-button--secondary" @onclick="HideModal">Cancel</button>
                <button class="wx-button" @onclick="SaveQuestion" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="material-symbols-outlined aqz-spinner">progress_activity</span>
                    }
                    else
                    {
                        <MaterialIcon Name="save" />
                    }
                    @(_isEditMode ? "Save Changes" : "Create Question")
                </button>
            </div>
        </div>
    </div>
}

<!-- Confirm Delete Modal -->
@if (_showDeleteConfirm)
{
    <div class="aqz-modal-backdrop" @onclick="() => _showDeleteConfirm = false">
        <div class="aqz-modal aqz-modal--sm" @onclick:stopPropagation>
            <div class="aqz-modal__header">
                <h2>Delete Question?</h2>
            </div>
            <div class="aqz-modal__body">
                <p>Are you sure you want to delete this question? This action cannot be undone.</p>
                <blockquote class="aqz-delete-preview">@_questionToDelete?.Text</blockquote>
            </div>
            <div class="aqz-modal__footer">
                <button class="wx-button wx-button--secondary" @onclick="() => _showDeleteConfirm = false">Cancel</button>
                <button class="wx-button wx-button--danger" @onclick="ExecuteDelete" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="material-symbols-outlined aqz-spinner">progress_activity</span>
                    }
                    else
                    {
                        <MaterialIcon Name="delete_forever" />
                    }
                    Delete Permanently
                </button>
            </div>
        </div>
    </div>
}

<style>
