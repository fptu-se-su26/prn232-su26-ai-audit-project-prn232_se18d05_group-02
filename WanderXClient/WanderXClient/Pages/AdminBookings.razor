@code {
    [Parameter] public Guid? BookingId { get; set; }

    private const int PageSize = 5;

    private readonly string[] _statusFilters = ["All", "Pending", "Confirmed", "Paid", "Cancelled", "Finished"];
    private readonly string[] _ticketTypes = ["Adult", "Child"];
    private List<BookingResponse> _bookings = new();
    private List<GuideTourAssignmentResponse> _schedules = new();
    private BookingResponse? _selectedBooking;
    private BookingResponse? _statusBooking;
    private BookingFormModel _form = NewForm();
    private StatusFormModel _statusForm = new();
    private DateTime _departureDate = DateTime.Today.AddDays(7);
    private string _selectedScheduleId = string.Empty;
    private string _statusFilter = "All";
    private string _searchTerm = string.Empty;
    private string? _message;
    private string? _error;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isFormOpen;
    private bool _isStatusFormOpen;
    private bool _isStatusNoticeOpen;
    private bool _isStatusSaving;
    private int _currentPage = 1;
    private string _statusNoticeTitle = string.Empty;
    private string _statusNoticeMessage = string.Empty;
    private string _statusNoticeIcon = "info";
    private string _statusNoticeChipText = string.Empty;
    private string _statusNoticeChipClass = "booking-status-notice__chip";

    private List<BookingResponse> FilteredBookings => _bookings.Where(MatchesCurrentFilters).ToList();
    private int FilteredBookingCount => FilteredBookings.Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredBookingCount / (double)PageSize));
    private int PageStart => FilteredBookingCount == 0 ? 0 : ((_currentPage - 1) * PageSize) + 1;
    private int PageEnd => Math.Min(_currentPage * PageSize, FilteredBookingCount);
    private IEnumerable<BookingResponse> PagedBookings => FilteredBookings
        .Skip((_currentPage - 1) * PageSize)
        .Take(PageSize);
    private IReadOnlyList<string> AvailableStatusOptions => _statusBooking is null
        ? Array.Empty<string>()
        : GetAllowedNextStatuses(_statusBooking.Status);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override void OnParametersSet()
    {
        ApplyRouteState(allowReset: false);
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var bookingsTask = UserApi.GetAllBookingsAsync();
            var schedulesTask = GuideTourApi.GetAssignmentsAsync();
            await Task.WhenAll(bookingsTask, schedulesTask);
            _bookings = (bookingsTask.Result ?? Enumerable.Empty<BookingResponse>()).ToList();
            _schedules = schedulesTask.Result;
        }
        catch (Exception ex)
        {
            _error = "Could not load booking data: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
            ClampCurrentPage();
            ApplyRouteState(allowReset: true);
        }
    }

    private void ApplyRouteState(bool allowReset)
    {
        var relativePath = NavManager.ToBaseRelativePath(NavManager.Uri).TrimEnd('/');
        if (relativePath.Equals("admin-bookings/new", StringComparison.OrdinalIgnoreCase))
        {
            OpenCreateForm();
            return;
        }

        if (BookingId.HasValue)
        {
            var booking = _bookings.FirstOrDefault(item => item.Id == BookingId.Value);
            if (booking is not null)
            {
                OpenEditForm(booking);
                return;
            }

            if (allowReset)
            {
                _isFormOpen = false;
            }
            return;
        }

        if (allowReset)
        {
            _isFormOpen = false;
            _selectedBooking = null;
        }
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        _searchTerm = args.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
    }

    private void SetStatusFilter(string status)
    {
        _statusFilter = status;
        _currentPage = 1;
    }

    private void SetPage(int page)
    {
        _currentPage = Math.Clamp(page, 1, TotalPages);
    }

    private void PreviousPage()
    {
        SetPage(_currentPage - 1);
    }

    private void NextPage()
    {
        SetPage(_currentPage + 1);
    }

    private void ClampCurrentPage()
    {
        _currentPage = Math.Clamp(_currentPage, 1, TotalPages);
    }

    private bool MatchesCurrentFilters(BookingResponse booking)
    {
        if (_statusFilter != "All" && !string.Equals(booking.Status, _statusFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            return true;
        }

        var term = _searchTerm.Trim();
        return booking.BookingCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            booking.TourName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            booking.Destination.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            booking.CustomerName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            booking.CustomerEmail.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            (booking.TourCode?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void OpenCreateForm()
    {
        _isStatusFormOpen = false;
        _isStatusNoticeOpen = false;
        _isFormOpen = true;
        ResetForm();
        _message = null;
        _error = null;
    }

    private void ResetForm()
    {
        _selectedBooking = null;
        _form = NewForm();
        _departureDate = DateTime.Today.AddDays(7);
        _selectedScheduleId = string.Empty;
    }

    private void CloseForm()
    {
        _isFormOpen = false;
        ResetForm();
        NavManager.NavigateTo("/admin-bookings");
    }

    private void OpenEditForm(BookingResponse booking)
    {
        _isStatusFormOpen = false;
        _isStatusNoticeOpen = false;
        _isFormOpen = true;
        _selectedBooking = booking;
        _selectedScheduleId = booking.DepartureScheduleId?.ToString() ?? string.Empty;
        _departureDate = booking.DepartureDate.Date;
        _message = null;
        _error = null;
        _form = new BookingFormModel
        {
            UserId = booking.UserId,
            UserEmail = booking.CustomerEmail,
            TourCode = booking.TourCode,
            DepartureScheduleId = booking.DepartureScheduleId,
            TourName = booking.TourName,
            Destination = booking.Destination,
            ThumbnailUrl = booking.ThumbnailUrl,
            TotalAmount = booking.TotalAmount,
            Passengers = booking.Passengers.Select(passenger => new BookingPassengerRequest
            {
                FullName = passenger.FullName,
                PhoneNumber = passenger.PhoneNumber,
                TicketType = NormalizeTicketType(passenger.TicketType)
            }).ToList()
        };

        if (_form.Passengers.Count == 0)
        {
            _form.Passengers.Add(NewPassenger());
        }
    }

    private async Task OpenStatusForm(BookingResponse booking)
    {
        if (IsTerminalStatus(booking.Status))
        {
            OpenStatusNotice(booking.Status);
            return;
        }

        _isFormOpen = false;
        _isStatusNoticeOpen = false;
        _isStatusFormOpen = true;
        _statusBooking = booking;
        _message = null;
        _error = null;

        var session = await SessionService.GetAsync();
        var options = GetAllowedNextStatuses(booking.Status);
        _statusForm = new StatusFormModel
        {
            Status = options.FirstOrDefault() ?? NormalizeStatusForForm(booking.Status),
            UpdatedBy = !string.IsNullOrWhiteSpace(session?.FullName)
                ? session.FullName
                : session?.Email ?? "Admin staff"
        };
    }

    private void CloseStatusForm()
    {
        _isStatusFormOpen = false;
        _statusBooking = null;
        _statusForm = new StatusFormModel();
    }

    private void OpenStatusNotice(string status)
    {
        _isFormOpen = false;
        _isStatusFormOpen = false;
        _statusBooking = null;
        _statusForm = new StatusFormModel();
        _message = null;
        _error = null;

        var normalizedStatus = NormalizeStatusForForm(status);
        _statusNoticeTitle = normalizedStatus == "Finished"
            ? "Tour already finished"
            : "Booking already cancelled";
        _statusNoticeMessage = normalizedStatus == "Finished"
            ? "This booking cannot be changed because the tour has already finished."
            : "This booking cannot be changed because it has already been cancelled.";
        _statusNoticeIcon = normalizedStatus == "Finished" ? "flag" : "block";
        _statusNoticeChipText = normalizedStatus;
        _statusNoticeChipClass = normalizedStatus == "Finished"
            ? "booking-status-notice__chip booking-status-notice__chip--finished"
            : "booking-status-notice__chip booking-status-notice__chip--cancelled";
        _isStatusNoticeOpen = true;
    }

    private void CloseStatusNotice()
    {
        _isStatusNoticeOpen = false;
        _statusNoticeTitle = string.Empty;
        _statusNoticeMessage = string.Empty;
        _statusNoticeIcon = "info";
        _statusNoticeChipText = string.Empty;
        _statusNoticeChipClass = "booking-status-notice__chip";
    }

    private async Task SaveStatusAsync()
    {
        if (_statusBooking is null)
        {
            return;
        }

        if (IsTerminalStatus(_statusBooking.Status))
        {
            _error = "Finished or cancelled bookings cannot change status.";
            return;
        }

        if (!AvailableStatusOptions.Contains(_statusForm.Status))
        {
            _error = "This status is not allowed for the current booking state.";
            return;
        }

        _isStatusSaving = true;
        _message = null;
        _error = null;

        try
        {
            var updated = await UserApi.UpdateBookingStatusAsync(_statusBooking.Id, new UpdateBookingStatusRequest
            {
                Status = _statusForm.Status,
                UpdatedBy = _statusForm.UpdatedBy
            });

            _message = $"Updated status for {updated?.BookingCode} to {updated?.Status}.";
            await LoadDataAsync();
            CloseStatusForm();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isStatusSaving = false;
        }
    }

    private void OnScheduleChanged(ChangeEventArgs args)
    {
        _selectedScheduleId = args.Value?.ToString() ?? string.Empty;
        _form.DepartureScheduleId = Guid.TryParse(_selectedScheduleId, out var scheduleId) ? scheduleId : null;

        var schedule = _schedules.FirstOrDefault(item => item.Id == _form.DepartureScheduleId);
        if (schedule is null)
        {
            return;
        }

        _form.TourCode = schedule.TourCode;
        _form.TourName = schedule.TourName;
        _form.Destination = schedule.Destination;
        _departureDate = schedule.StartDate.Date;
    }

    private void AddPassenger()
    {
        _form.Passengers.Add(NewPassenger());
    }

    private void RemovePassenger(int index)
    {
        if (_form.Passengers.Count > 1 && index >= 0 && index < _form.Passengers.Count)
        {
            _form.Passengers.RemoveAt(index);
        }
    }

    private async Task SaveBookingAsync()
    {
        _isSaving = true;
        _message = null;
        _error = null;

        try
        {
            if (_selectedBooking is null)
            {
                var created = await UserApi.CreateBookingAsync(new CreateBookingRequest
                {
                    UserId = _form.UserId,
                    UserEmail = _form.UserEmail,
                    TourCode = _form.TourCode,
                    DepartureScheduleId = _form.DepartureScheduleId,
                    TourName = _form.TourName,
                    Destination = _form.Destination,
                    ThumbnailUrl = _form.ThumbnailUrl,
                    DepartureDate = _departureDate,
                    GuestCount = _form.Passengers.Count,
                    TotalAmount = _form.TotalAmount,
                    Passengers = _form.Passengers
                });

                _message = $"Created booking {created?.BookingCode}.";
            }
            else
            {
                var updated = await UserApi.UpdateBookingAsync(_selectedBooking.Id, new UpdateBookingRequest
                {
                    TourCode = _form.TourCode,
                    DepartureScheduleId = _form.DepartureScheduleId,
                    TourName = _form.TourName,
                    Destination = _form.Destination,
                    ThumbnailUrl = _form.ThumbnailUrl,
                    DepartureDate = _departureDate,
                    GuestCount = _form.Passengers.Count,
                    TotalAmount = _form.TotalAmount,
                    Passengers = _form.Passengers
                });

                _message = $"Updated booking {updated?.BookingCode}.";
            }

            await LoadDataAsync();
            CloseForm();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static BookingFormModel NewForm()
    {
        return new BookingFormModel
        {
            Passengers = [NewPassenger()]
        };
    }

    private static BookingPassengerRequest NewPassenger()
    {
        return new BookingPassengerRequest
        {
            TicketType = "Adult"
        };
    }

    private static string NormalizeTicketType(string? ticketType)
    {
        if (string.Equals(ticketType, "Child", StringComparison.OrdinalIgnoreCase))
        {
            return "Child";
        }

        return "Adult";
    }

    private static string GetStatusClass(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "pending" => "booking-status booking-status--pending",
            "paid" => "booking-status booking-status--paid",
            "confirmed" or "confirm" => "booking-status booking-status--confirmed",
            "cancelled" => "booking-status booking-status--cancelled",
            "finished" or "finish" => "booking-status booking-status--finished",
            _ => "booking-status booking-status--default"
        };
    }

    private static string NormalizeStatusForForm(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "confirmed" or "confirm" => "Confirmed",
            "finished" or "finish" => "Finished",
            "cancelled" or "cancel" => "Cancelled",
            "paid" => "Paid",
            _ => "Pending"
        };
    }

    private static IReadOnlyList<string> GetAllowedNextStatuses(string currentStatus)
    {
        return NormalizeStatusForForm(currentStatus) switch
        {
            "Pending" => ["Confirmed", "Cancelled"],
            "Paid" => ["Confirmed", "Cancelled"],
            "Confirmed" => ["Finished", "Cancelled"],
            _ => Array.Empty<string>()
        };
    }

    private static bool IsTerminalStatus(string status)
    {
        var normalizedStatus = NormalizeStatusForForm(status);
        return normalizedStatus is "Finished" or "Cancelled";
    }

    private static string GetStatusActionTitle(string status)
    {
        return IsTerminalStatus(status)
            ? "Why status is locked"
            : "Update status";
    }

    private static string FormatStatusAudit(BookingResponse booking)
    {
        var updatedBy = string.IsNullOrWhiteSpace(booking.StatusUpdatedBy)
            ? "Unknown"
            : booking.StatusUpdatedBy;

        if (!booking.StatusUpdatedAt.HasValue)
        {
            return $"By {updatedBy}";
        }

        return $"By {updatedBy} · {booking.StatusUpdatedAt.Value:dd/MM/yyyy HH:mm}";
    }

    private sealed class BookingFormModel
    {
        public Guid? UserId { get; set; }

        [EmailAddress]
        public string? UserEmail { get; set; }

        [StringLength(32)]
        public string? TourCode { get; set; }

        public Guid? DepartureScheduleId { get; set; }

        [StringLength(200)]
        public string? TourName { get; set; }

        [StringLength(200)]
        public string? Destination { get; set; }

        [StringLength(500)]
        public string? ThumbnailUrl { get; set; }

        [Range(0.01, 999999999999)]
        public decimal TotalAmount { get; set; } = 1000000;

        public List<BookingPassengerRequest> Passengers { get; set; } = new();
    }

    private sealed class StatusFormModel
    {
        [Required]
        public string Status { get; set; } = "Pending";

        [StringLength(120)]
        public string? UpdatedBy { get; set; }
    }
}


