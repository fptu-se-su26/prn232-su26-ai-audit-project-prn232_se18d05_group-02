@page "/forgot-password"
@inject AuthApiClient AuthApi

<PageTitle>Forgot Password - WanderX</PageTitle>

<AuthShell
    Title="Forgot Password?"
    Subtitle="Enter the email address associated with your account and we will prepare a secure reset token."
    Compact="true"
    BackgroundImage="https://lh3.googleusercontent.com/aida-public/AB6AXuD5Rrppqh3d39v2CB4PgS8xIqVwrhX4vzDsXwAQoUCzNpJGZ8UlCtyWDS5CJAKot5U--OR_zULtCECfWNbEgL0fFUYPk5gGGDh9y5bjKVF5dc2PKnYnUgrfg_PMbnfANJmhkzq8cm9SbTeysz8T1mJF5kBK4y9Lus0WFEXY2F5HVB8UrYrARoqBSVtx0qYni_bwxUmCK_gn6A8FJMYHK6faLa3qJ8zfk04q3-QblRirlEaXg2AmFRagcp2qTIdrb2nnCsHXQ7L-Vw">
    <EditForm Model="@_model" OnValidSubmit="@SubmitAsync" class="auth-form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <AuthInput
            Id="forgot-email"
            Label="Email Address"
            Icon="mail"
            Type="email"
            AutoComplete="email"
            Placeholder="concierge@wanderx.com"
            @bind-Value="_model.Email" />

        <button class="wx-button wx-button--secondary" type="submit" disabled="@_isBusy">
            @(_isBusy ? "Sending..." : "Send Reset Link")
            <MaterialIcon Name="arrow_forward" />
        </button>

        <AuthStatusMessage Message="@_message" IsError="@_isError" />

        @if (!string.IsNullOrWhiteSpace(_resetToken))
        {
            <div class="auth-alert auth-alert--success">
                Development reset token: @_resetToken
            </div>
        }

        <a class="back-link" href="/login">
            <MaterialIcon Name="arrow_back" />
            Back to Login
        </a>
    </EditForm>
</AuthShell>

@code {
    private readonly ForgotPasswordRequest _model = new();
    private bool _isBusy;
    private bool _isError;
    private string? _message;
    private string? _resetToken;

    private async Task SubmitAsync()
    {
        _isBusy = true;
        _message = null;
        _resetToken = null;
        _isError = false;

        try
        {
            var response = await AuthApi.ForgotPasswordAsync(_model);
            _message = response?.Message ?? "If the email exists, a reset link has been prepared.";
            _resetToken = response?.ResetToken;
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ToUserMessage(ex);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string ToUserMessage(Exception exception)
    {
        return exception.Message.Contains('{')
            ? "The reset request could not be completed. Please try again."
            : exception.Message;
    }
}
