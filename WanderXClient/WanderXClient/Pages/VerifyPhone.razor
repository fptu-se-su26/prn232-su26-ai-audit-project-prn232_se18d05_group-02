@page "/account/verify-phone"
@using WanderXClient.Models
@using WanderXClient.Services
@inject UserApiClient Api
<PageTitle>Xác minh số điện thoại - WanderX</PageTitle><AppHeader/>
<main class="verify"><section><span class="eyebrow">ACCOUNT SECURITY</span><h1>Xác minh số điện thoại</h1><p>Mã gồm 6 chữ số, hết hạn sau 5 phút. WanderX không lưu OTP dạng rõ.</p>@if(_error!=null){<div class="error">@_error</div>}@if(_done){<div class="success">Số điện thoại đã được xác minh thành công.</div>}else if(_sent==null){<label>Số điện thoại<input @bind="_phone" placeholder="+84901234567"/></label><button class="wx-button" @onclick="Send">Gửi mã OTP</button>}else{<p>Mã đã gửi tới <strong>@_sent.MaskedPhone</strong></p><label>Mã OTP<input maxlength="6" inputmode="numeric" @bind="_otp"/></label><button class="wx-button" @onclick="Verify">Xác minh</button><button class="link" @onclick="Send">Gửi lại mã</button>}</section></main><AppFooter/>
<style>.verify{min-height:70vh;display:grid;place-items:center;padding:50px 20px;background:#f8fafc}.verify section{width:min(480px,100%);display:grid;gap:17px;padding:34px;background:#fff;border:1px solid #e2e8f0;border-radius:20px;box-shadow:0 15px 40px rgba(15,23,42,.08)}.verify h1{margin:0;font-size:34px}.verify p{color:#64748b}.verify label{display:grid;gap:7px;font-weight:700}.verify input{padding:13px;border:1px solid #cbd5e1;border-radius:10px}.eyebrow{font-size:11px;font-weight:800;letter-spacing:.15em;color:#ff5a5f}.error,.success{padding:12px;border-radius:9px}.error{background:#fef2f2;color:#991b1b}.success{background:#dcfce7;color:#166534}.link{border:0;background:none;color:#ff5a5f}</style>
@code{private string _phone="",_otp="";private SendPhoneOtpResponse? _sent;private string? _error;private bool _done;private async Task Send(){try{_error=null;_sent=await Api.SendPhoneOtpAsync(new(){PhoneNumber=_phone});}catch(Exception e){_error=e.Message;}}private async Task Verify(){try{_error=null;await Api.VerifyPhoneOtpAsync(new(){VerificationId=_sent!.VerificationId,Otp=_otp});_done=true;}catch(Exception e){_error=e.Message;}}}