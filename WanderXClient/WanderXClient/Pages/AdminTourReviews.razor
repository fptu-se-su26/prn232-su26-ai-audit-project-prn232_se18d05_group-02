@page "/tour-reviews"
@layout AdminLayout
@using WanderXClient.Models
@using WanderXClient.Services
@inject UserApiClient UserApi
@inject AuthSessionService SessionService
@inject NavigationManager NavManager

<PageTitle>WanderX Admin - Tour Review Management</PageTitle>


        @if (_isLoading)
        {
            <div class="guide-empty">
                <MaterialIcon Name="sync" />
                Loading data...
            </div>
        }
        else if (_session == null || _session.Role != "Admin")
        {
            <div class="guide-empty">
                <MaterialIcon Name="admin_panel_settings" />
                <h2>Access denied</h2>
                <p>You need admin permission to access this page.</p>
                <a class="wx-button wx-button--secondary" href="/">
                    <MaterialIcon Name="home" />
                    Back to home
                </a>
            </div>
        }
        else
        {
            <!-- Header -->
            <header class="guide-topbar">
                <div>
                    <p class="guide-eyebrow">Management</p>
                    <h1>Tour Reviews</h1>
                    <p class="guide-subtitle">View and manage customer reviews</p>
                </div>
            </header>

            <section class="guide-content">
                <!-- Stats -->
                <div class="guide-stat-grid">
                    <article class="guide-stat">
                        <p>Total Reviews</p>
                        <strong>@(_reviews?.Count ?? 0)</strong>
                        <span>All reviews</span>
                    </article>
                    <article class="guide-stat guide-stat--secondary">
                        <p>Visible</p>
                        <strong>@(_reviews?.Count(r => r.Status == "Visible") ?? 0)</strong>
                        <span>Publicly visible</span>
                    </article>
                    <article class="guide-stat guide-stat--tertiary">
                        <p>Hidden</p>
                        <strong>@(_reviews?.Count(r => r.Status == "Hidden") ?? 0)</strong>
                        <span>Not visible</span>
                    </article>
                    <article class="guide-stat">
                        <p>Deleted</p>
                        <strong>@(_reviews?.Count(r => r.Status == "Deleted") ?? 0)</strong>
                        <span>Deleted reviews</span>
                    </article>
                </div>

                <!-- Filters -->
                <section class="guide-form-panel">
                    <div class="guide-section-heading">
                        <div>
                            <p class="guide-eyebrow">Filters</p>
                            <h2>Filter reviews</h2>
                        </div>
                        <div class="guide-topbar__actions">
                            <label class="guide-search" aria-label="Search">
                                <MaterialIcon Name="search" />
                                <input type="search" placeholder="Search by tour, user..." value="@_searchQuery" @oninput="OnSearchInput" />
                            </label>
                        </div>
                    </div>
                    <div class="guide-filter-group" role="group">
                        @foreach (var f in new[] { "All", "Visible", "Hidden", "Deleted" })
                        {
                            <button class="@(_statusFilter == f ? "guide-filter guide-filter--active" : "guide-filter")"
                                    type="button" @onclick="() => SetStatusFilter(f)">
                                @f
                            </button>
                        }
                    </div>
                    <div class="guide-filter-group" role="group" style="margin-top: 12px;">
                        @foreach (var f in new[] { "All", "5 stars", "4 stars", "3 stars", "2 stars", "1 star" })
                        {
                            <button class="@(_ratingFilter == f ? "guide-filter guide-filter--active" : "guide-filter")"
                                    type="button" @onclick="() => SetRatingFilter(f)">
                                @f
                            </button>
                        }
                    </div>
                </section>

                <!-- Reviews List -->
                @if (_reviews == null || !FilteredReviews.Any())
                {
                    <div class="guide-empty">
                        <MaterialIcon Name="rate_review" />
                        <h3>No reviews found</h3>
                        <p>Try changing the search filters</p>
                    </div>
                }
                else
                {
                    <div class="atr-reviews-list">
                        @foreach (var review in FilteredReviews)
                        {
                            <div class="atr-review-card @(GetReviewCardClass(review.Status))">
                                <div class="atr-review-card__header">
                                    <div class="guide-person">
                                        <div class="guide-avatar atr-avatar">
                                            @GetInitials(review.UserName)
                                        </div>
                                        <div>
                                            <strong>@review.UserName</strong>
                                            <span>@review.BookingCode</span>
                                            <span class="atr-meta-small">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                    </div>
                                    <div class="atr-review-status">
                                        <span class="@GetStatusClass(review.Status)">
                                            <span></span>@GetStatusText(review.Status)
                                        </span>
                                        <div class="atr-rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span class="material-symbols-outlined @(i <= review.Rating ? "atr-rating--filled" : "atr-rating--empty")">
                                                    @(i <= review.Rating ? "star" : "star_border")
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="atr-review-card__body">
                                    <div class="atr-review-field">
                                        <label class="atr-label">Tour:</label>
                                        <p class="atr-value">@review.TourName</p>
                                    </div>

                                    @if (!string.IsNullOrEmpty(review.Comment))
                                    {
                                        <div class="atr-review-field">
                                            <label class="atr-label">Comment:</label>
                                            <p class="atr-value atr-comment">@review.Comment</p>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(review.TravelPhotos))
                                    {
                                        <div class="atr-review-field">
                                            <label class="atr-label">Travel photo:</label>
                                            <p class="atr-value" style="font-size: 13px; color: var(--guide-muted);">@review.TravelPhotos</p>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(review.ModerationReason))
                                    {
                                        <div class="atr-moderation-info">
                                            <label class="atr-label">Moderation reason:</label>
                                            <p>@review.ModerationReason</p>
                                            @if (review.ModeratedAt.HasValue)
                                            {
                                                <span class="atr-meta">Moderated at: @review.ModeratedAt.Value.ToString("dd/MM/yyyy HH:mm") by @review.ModeratorName</span>
                                            }
                                        </div>
                                    }

                                    @if (review.UpdatedAt.HasValue)
                                    {
                                        <span class="atr-meta">Last updated: @review.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                </div>

                                <!-- Actions -->
                                <div class="atr-review-card__actions">
                                    @if (review.Status == "Visible")
                                    {
                                        <button class="wx-button wx-button--outline" style="font-size:12px;padding:6px 14px"
                                                type="button" @onclick="@(() => ShowModerateModal(review.Id, "Hidden"))">
                                            <MaterialIcon Name="visibility_off" />
                                            Hide review
                                        </button>
                                    }
                                    else if (review.Status == "Hidden")
                                    {
                                        <button class="wx-button wx-button--outline" style="font-size:12px;padding:6px 14px"
                                                type="button" @onclick="@(() => ShowModerateModal(review.Id, "Visible"))">
                                            <MaterialIcon Name="visibility" />
                                            Show again
                                        </button>
                                    }
                                    @if (review.Status != "Deleted")
                                    {
                                        <button class="wx-button wx-button--outline atr-btn-delete" style="font-size:12px;padding:6px 14px"
                                                type="button" @onclick="@(() => ShowModerateModal(review.Id, "Deleted"))">
                                            <MaterialIcon Name="delete" />
                                            Delete review
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pagination -->
                    @if (TotalPages >= 1)
                    {
                        <div class="atr-pagination">
                            <span class="atr-pagination-info">Page @_currentPage / @TotalPages (@AllFilteredReviews.Count() results)</span>
                            <div class="atr-pagination-controls">
                                <button class="atr-pagination-btn" disabled="@(_currentPage <= 1)" @onclick="PrevPage" title="Previous page">
                                    <MaterialIcon Name="chevron_left" />
                                </button>
                                @for (var p = 1; p <= TotalPages; p++)
                                {
                                    var pg = p;
                                    <button class="atr-pagination-btn @(_currentPage == pg ? "atr-pagination-btn--active" : "")"
                                            @onclick="() => GoToPage(pg)">@pg</button>
                                }
                                <button class="atr-pagination-btn" disabled="@(_currentPage >= TotalPages)" @onclick="NextPage" title="Next page">
                                    <MaterialIcon Name="chevron_right" />
                                </button>
                            </div>
                        </div>
                    }
                }
            </section>
        }
<!-- Moderate modal sits outside the list content for proper positioning. -->
@if (_showModerateModal)
{
    <div class="atr-modal-overlay" @onclick="HideModerateModal">
        <div class="atr-modal" @onclick:stopPropagation="true">
            <div class="atr-modal__header">
                <div>
                    <h2>Moderate review</h2>
                    <p class="guide-subtitle atr-modal-subtitle">@(_moderationAction == "Hidden" ? "Hide the review from public display" : _moderationAction == "Deleted" ? "Permanently delete the review" : "Show the review again")</p>
                </div>
                <button class="guide-icon-button" type="button" @onclick="HideModerateModal">
                    <MaterialIcon Name="close" />
                </button>
            </div>

            <div class="atr-modal__body">
                @if (_moderationAction != "Visible")
                {
                    <div class="guide-field">
                        <label for="moderation-reason" class="atr-label">Moderation reason:</label>
                        <textarea id="moderation-reason"
                                  class="guide-control guide-control--area"
                                  rows="4"
                                  placeholder="Enter the moderation reason..."
                                  @bind="_moderationReason"></textarea>
                    </div>
                }
                else
                {
                    <p class="atr-confirm-text">Are you sure you want to show this review again?</p>
                }
            </div>

            <div class="atr-modal__footer">
                <div class="atr-modal__actions">
                    <button class="wx-button wx-button--outline" type="button" @onclick="HideModerateModal" disabled="@_isSubmitting">
                        Cancel
                    </button>
                    <button class="wx-button wx-button--secondary" type="button" @onclick="SubmitModeration" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <MaterialIcon Name="sync" class="atr-spin" />
                            <span>Processing...</span>
                        }
                        else
                        {
                            <MaterialIcon Name="check_circle" />
                            <span>Confirm</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private bool _showModerateModal = false;
    private AuthSession? _session;
    private List<TourReviewResponse>? _reviews;
    private string _searchQuery = string.Empty;
    private string _statusFilter = "All";
    private string _ratingFilter = "All";
    private Guid _selectedReviewId;
    private string _moderationAction = string.Empty;
    private string _moderationReason = string.Empty;

    // Pagination
    private const int PageSize = 10;
    private int _currentPage = 1;

    // Computed property for filtered reviews (before pagination)
    private IEnumerable<TourReviewResponse> AllFilteredReviews => _reviews?
        .Where(r =>
        {
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var t = _searchQuery.Trim();
                if (!r.TourName.Contains(t, StringComparison.OrdinalIgnoreCase) &&
                    !r.UserName.Contains(t, StringComparison.OrdinalIgnoreCase) &&
                    !r.BookingCode.Contains(t, StringComparison.OrdinalIgnoreCase))
                    return false;
            }

            return _statusFilter switch
            {
                "Visible" => r.Status == "Visible",
                "Hidden" => r.Status == "Hidden",
                "Deleted" => r.Status == "Deleted",
                _ => true
            };
        })
        .Where(r =>
        {
            return _ratingFilter switch
            {
                "5 stars" => r.Rating == 5,
                "4 stars" => r.Rating == 4,
                "3 stars" => r.Rating == 3,
                "2 stars" => r.Rating == 2,
                "1 star" => r.Rating == 1,
                _ => true
            };
        })
        .OrderByDescending(r => r.CreatedAt) ?? Enumerable.Empty<TourReviewResponse>();

    // Computed property for paginated reviews
    private IEnumerable<TourReviewResponse> FilteredReviews => AllFilteredReviews
        .Skip((_currentPage - 1) * PageSize)
        .Take(PageSize);

    // Total pages calculation
    private int TotalPages => AllFilteredReviews.Any()
        ? (int)Math.Ceiling(AllFilteredReviews.Count() / (double)PageSize)
        : 1;

    protected override async Task OnInitializedAsync()
    {
        _session = await SessionService.GetAsync();
        if (_session == null || _session.Role != "Admin")
        {
            _isLoading = false;
            return;
        }

        await LoadReviews();
    }

    private async Task LoadReviews()
    {
        _isLoading = true;
        try
        {
            var allReviews = await UserApi.GetAllReviewsAsync();
            _reviews = allReviews?.ToList() ?? new List<TourReviewResponse>();
        }
        catch (Exception)
        {
            _reviews = new List<TourReviewResponse>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        _currentPage = 1; // Reset to page 1 when searching
        StateHasChanged();
    }

    private void SetStatusFilter(string filter)
    {
        _statusFilter = filter;
        _currentPage = 1; // Reset to page 1 when filtering
    }

    private void SetRatingFilter(string filter)
    {
        _ratingFilter = filter;
        _currentPage = 1; // Reset to page 1 when filtering
    }

    private void GoToPage(int page)
    {
        _currentPage = page;
        StateHasChanged();
    }

    private void PrevPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            StateHasChanged();
        }
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
            StateHasChanged();
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        }
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    private string GetReviewCardClass(string status)
    {
        return status switch
        {
            "Visible" => "atr-review-card--visible",
            "Hidden" => "atr-review-card--hidden",
            "Deleted" => "atr-review-card--deleted",
            _ => ""
        };
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Visible" => "atr-status-visible",
            "Hidden" => "atr-status-hidden",
            "Deleted" => "atr-status-deleted",
            _ => ""
        };
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "Visible" => "Visible",
            "Hidden" => "Hidden",
            "Deleted" => "Deleted",
            _ => status
        };
    }

    private void ShowModerateModal(Guid reviewId, string action)
    {
        _selectedReviewId = reviewId;
        _moderationAction = action;
        _moderationReason = string.Empty;
        _showModerateModal = true;
    }

    private void HideModerateModal()
    {
        _showModerateModal = false;
        _selectedReviewId = Guid.Empty;
        _moderationAction = string.Empty;
        _moderationReason = string.Empty;
    }

    private async Task SubmitModeration()
    {
        if (_selectedReviewId == Guid.Empty) return;

        _isSubmitting = true;
        try
        {
            var request = new ModerateReviewRequest
            {
                Status = _moderationAction,
                Reason = _moderationAction == "Visible" ? null : _moderationReason
            };

            await UserApi.ModerateReviewAsync(_selectedReviewId, request);

            HideModerateModal();
            await LoadReviews();
        }
        catch (Exception)
        {
            // Handle error - could show a toast notification
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}

