@code {
    private const int PageSize = 5;
    private readonly string[] _statusFilters = ["All", "Unpaid", "Deposit Paid", "Paid", "Failed"];
    private readonly List<BookingResponse> _payments = new();
    private bool _isLoading = true;
    private bool _isSavingPayment;
    private string _statusFilter = "All";
    private string _searchTerm = string.Empty;
    private string _message = string.Empty;
    private string _error = string.Empty;
    private string _paymentError = string.Empty;
    private string _paymentUpdatedBy = "Admin staff";
    private int _currentPage = 1;
    private BookingResponse? _paymentBooking;
    private BookingResponse? _invoiceBooking;
    private PaymentForm _paymentForm = new();

    private decimal PaymentPreviewAmount => _paymentBooking is null ? 0m : CalculatePaymentAmount(_paymentBooking, _paymentForm.PaymentOption);
    private decimal PaymentPreviewRemaining => _paymentBooking is null ? 0m : Math.Max(_paymentBooking.TotalAmount - PaymentPreviewAmount, 0m);

    private IEnumerable<BookingResponse> FilteredPayments
    {
        get
        {
            var query = _payments.AsEnumerable();

            if (_statusFilter != "All")
            {
                query = query.Where(item => GetPaymentStatus(item) == _statusFilter);
            }

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(item =>
                    item.BookingCode.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    item.TourName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    item.Destination.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (item.TourCode?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    item.CustomerName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    item.CustomerEmail.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    private int FilteredCount => FilteredPayments.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCount / (double)PageSize));
    private int PageStart => FilteredCount == 0 ? 0 : ((_currentPage - 1) * PageSize) + 1;
    private int PageEnd => Math.Min(_currentPage * PageSize, FilteredCount);
    private IEnumerable<BookingResponse> PagedPayments => FilteredPayments.Skip((_currentPage - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        var session = await SessionService.GetAsync();
        _paymentUpdatedBy = string.IsNullOrWhiteSpace(session?.FullName)
            ? session?.Email ?? "Admin staff"
            : session.FullName;

        await LoadPaymentsAsync();
    }

    private async Task LoadPaymentsAsync()
    {
        _isLoading = true;
        _error = string.Empty;

        try
        {
            var payments = await UserApi.GetPaymentsAsync();
            _payments.Clear();
            if (payments is not null)
            {
                _payments.AddRange(payments);
            }
            ClampPage();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        _searchTerm = args.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
    }

    private void SetStatusFilter(string status)
    {
        _statusFilter = status;
        _currentPage = 1;
    }

    private void SetPage(int page) => _currentPage = Math.Clamp(page, 1, TotalPages);
    private void PreviousPage() => SetPage(_currentPage - 1);
    private void NextPage() => SetPage(_currentPage + 1);
    private void ClampPage() => _currentPage = Math.Clamp(_currentPage, 1, TotalPages);

    private void OpenPaymentModal(BookingResponse booking)
    {
        _paymentBooking = booking;
        var defaultOption = (booking.PaidAmount ?? 0m) > 0m && GetRemainingAmount(booking) > 0m ? "Balance" : booking.PaymentOption ?? "Full";
        _paymentForm = new PaymentForm
        {
            PaymentOption = defaultOption,
            PaymentMethod = booking.PaymentMethod ?? "Bank Transfer",
            PaymentReference = booking.PaymentReference,
            PaymentNote = booking.PaymentNote
        };
        _paymentError = string.Empty;
        _message = string.Empty;
    }

    private void ClosePaymentModal()
    {
        if (_isSavingPayment)
        {
            return;
        }

        _paymentBooking = null;
        _paymentError = string.Empty;
    }

    private async Task SavePaymentAsync()
    {
        if (_paymentBooking is null)
        {
            return;
        }

        _isSavingPayment = true;
        _paymentError = string.Empty;
        _message = string.Empty;

        try
        {
            var updated = await UserApi.UpdatePaymentAsync(_paymentBooking.Id, new UpdatePaymentRequest
            {
                PaymentOption = _paymentForm.PaymentOption,
                PaymentMethod = _paymentForm.PaymentMethod,
                PaymentReference = string.IsNullOrWhiteSpace(_paymentForm.PaymentReference) ? null : _paymentForm.PaymentReference.Trim(),
                UpdatedBy = _paymentUpdatedBy,
                PaymentNote = string.IsNullOrWhiteSpace(_paymentForm.PaymentNote) ? null : _paymentForm.PaymentNote.Trim()
            });

            if (updated is not null)
            {
                var index = _payments.FindIndex(item => item.Id == updated.Id);
                if (index >= 0)
                {
                    _payments[index] = updated;
                }
            }

            _message = "Payment record saved.";
            _paymentBooking = null;
        }
        catch (Exception ex)
        {
            _paymentError = ex.Message;
        }
        finally
        {
            _isSavingPayment = false;
        }
    }

    private void OpenInvoiceModal(BookingResponse booking)
    {
        _invoiceBooking = booking;
    }

    private void CloseInvoiceModal()
    {
        _invoiceBooking = null;
    }

    private async Task PrintInvoiceAsync()
    {
        await JSRuntime.InvokeVoidAsync("print");
    }

    private static bool CanRecordPayment(BookingResponse booking)
    {
        return !IsPaymentLocked(booking) && GetPaymentStatus(booking) != "Paid";
    }

    private static bool IsPaymentLocked(BookingResponse booking)
    {
        return booking.Status is "Cancelled" or "Finished";
    }

    private static decimal CalculatePaymentAmount(BookingResponse booking, string option)
    {
        return option switch
        {
            "Deposit40" => decimal.Round(booking.TotalAmount * 0.4m, 2, MidpointRounding.AwayFromZero),
            "Balance" => booking.TotalAmount,
            _ => booking.TotalAmount
        };
    }

    private static decimal GetRemainingAmount(BookingResponse booking)
    {
        if (booking.RemainingAmount.HasValue)
        {
            return Math.Max(booking.RemainingAmount.Value, 0m);
        }

        return Math.Max(booking.TotalAmount - (booking.PaidAmount ?? 0m), 0m);
    }

    private static string GetPaymentStatus(BookingResponse booking)
    {
        if (booking.PaymentFailedAt.HasValue)
        {
            return "Failed";
        }

        if (!booking.PaidAt.HasValue || (booking.PaidAmount ?? 0m) <= 0m)
        {
            return "Unpaid";
        }

        return GetRemainingAmount(booking) > 0m ? "Deposit Paid" : "Paid";
    }

    private static string GetPaymentStatusClass(BookingResponse booking)
    {
        return GetPaymentStatus(booking) switch
        {
            "Paid" => "payment-status payment-status--paid",
            "Deposit Paid" => "payment-status payment-status--deposit",
            "Failed" => "payment-status payment-status--failed",
            _ => "payment-status payment-status--unpaid"
        };
    }

    private static string GetPaymentActionTitle(BookingResponse booking)
    {
        return IsPaymentLocked(booking) ? "Payment locked" : "Record payment";
    }

    private static string FormatPaymentAudit(BookingResponse booking)
    {
        var by = string.IsNullOrWhiteSpace(booking.PaymentUpdatedBy) ? "Admin staff" : booking.PaymentUpdatedBy;
        return booking.PaymentUpdatedAt.HasValue
            ? $"{booking.PaymentUpdatedAt.Value.ToLocalTime():dd/MM/yyyy HH:mm} by {by}"
            : $"By {by}";
    }

    private static string Money(decimal value) => $"{value.ToString("N0", CultureInfo.InvariantCulture)} VND";

    private sealed class PaymentForm
    {
        public string PaymentOption { get; set; } = "Full";
        public string PaymentMethod { get; set; } = "Bank Transfer";
        public string? PaymentReference { get; set; }
        public string? PaymentNote { get; set; }
    }
}
