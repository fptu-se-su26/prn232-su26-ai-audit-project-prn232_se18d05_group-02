@page "/dashboard"
@page "/admin-dashboard"

@layout AdminLayout
<PageTitle>Admin Dashboard - WanderX</PageTitle>


        <header class="guide-topbar">
            <div>
                <p class="guide-eyebrow">Admin</p>
                <h1>Dashboard</h1>
                <p class="guide-subtitle">System overview and operations shortcuts.</p>
            </div>
        </header>

        <section class="guide-content">
            <div class="guide-stat-grid">
                <article class="guide-stat">
                    <p>Tour Management</p>
                    <strong>01</strong>
                    <span>Manage travel tour packages</span>
                </article>
                <article class="guide-stat guide-stat--secondary">
                    <p>Assignments</p>
                    <strong>02</strong>
                    <span>Track tour staffing work</span>
                </article>
                <article class="guide-stat guide-stat--tertiary">
                    <p>Operations</p>
                    <strong>03</strong>
                    <span>Monitor active tour support</span>
                </article>
                <article class="guide-stat">
                    <p>Accounts</p>
                    <strong>04</strong>
                    <span>Role-based access entry point</span>
                </article>
            </div>

            <section class="guide-form-panel">
                <div class="guide-section-heading">
                    <div>
                        <p class="guide-eyebrow">Quick action</p>
                        <h2>Guide Operations</h2>
                    </div>
                    <div class="guide-form-actions">
                        <a class="wx-button" href="/guides">
                            <MaterialIcon Name="badge" />
                            Open Guides
                        </a>
                        <a class="wx-button" href="/admin/tours">
                            <MaterialIcon Name="travel_explore" />
                            Open Tours
                        </a>
                        <a class="wx-button wx-button--secondary" href="/guide-assignments">
                            <MaterialIcon Name="assignment_ind" />
                            Open Assignments
                        </a>
                    </div>
                </div>
                <p class="guide-subtitle">Use this dashboard as the admin landing page after login. Guide profiles and guide-to-tour assignments are managed in separate operation screens.</p>
            </section>
        </section>


