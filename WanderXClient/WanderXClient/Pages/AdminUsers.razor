@page "/admin/users"
@page "/admin/users/{UserId:guid}"
@layout AdminLayout
@using WanderXClient.Models
@using WanderXClient.Services
@inject UserApiClient Api
<PageTitle>Account Management - WanderX</PageTitle>
<header class="guide-topbar"><div><p class="guide-eyebrow">USER_MANAGE</p><h1>Quản lý tài khoản</h1><p class="guide-subtitle">Tìm kiếm, phân quyền, khóa/mở khóa và xem audit log.</p></div></header>
<section class="guide-content accounts"><section class="account-filter"><input placeholder="Tên, email, số điện thoại" @bind="_keyword"/><select @bind="_role"><option value="">Tất cả role</option><option>Customer</option><option>Guide</option><option>Staff</option><option>Admin</option></select><select @bind="_status"><option value="">Tất cả trạng thái</option><option>Active</option><option>Locked</option><option>Inactive</option></select><select @bind="_verified"><option value="">Phone bất kỳ</option><option value="true">Đã verify</option><option value="false">Chưa verify</option></select><button class="wx-button" @onclick="Load">Lọc</button></section>
@if(_error!=null){<div class="account-error">@_error</div>}
<div class="account-layout"><section class="account-panel"><table><thead><tr><th>Tài khoản</th><th>Role</th><th>Trạng thái</th><th>Phone</th><th></th></tr></thead><tbody>@foreach(var u in _page.Items){<tr><td><strong>@u.FullName</strong><small>@u.Email<br/>@u.PhoneNumber</small></td><td><span class="badge">@u.Role</span></td><td><span class="badge @(u.Status=="Locked"?"danger":"ok")">@u.Status</span></td><td>@(u.PhoneVerified?"Verified":"Unverified")</td><td><button @onclick="()=>Select(u.Id)">Chi tiết</button></td></tr>}</tbody></table><nav><button disabled="@(_page.Page<=1)" @onclick="Prev">Trước</button><span>Trang @_page.Page · @_page.TotalCount user</span><button disabled="@(_page.Page*_page.PageSize>=_page.TotalCount)" @onclick="Next">Sau</button></nav></section>
@if(_detail!=null){<aside class="account-panel detail"><h2>@_detail.FullName</h2><p>@_detail.Email · @_detail.PhoneNumber</p><div class="permissions">@foreach(var p in _detail.Permissions){<span>@p</span>}</div><label>Role mới<select @bind="_newRole"><option>Customer</option><option>Guide</option><option>Staff</option><option>Admin</option></select></label><label>Lý do<textarea @bind="_reason"></textarea></label><button class="wx-button" @onclick="ChangeRole">Đổi role</button>@if(_detail.Status=="Locked"){<button class="wx-button wx-button--secondary" @onclick="Unlock">Mở khóa</button>}else{<label>Khóa đến (để trống = vô thời hạn)<InputDate @bind-Value="_lockUntil" /></label><button class="danger-button" @onclick="Lock">Khóa tài khoản</button>}<h3>Audit log</h3><div class="audit">@foreach(var x in _detail.AuditLogs){<article><strong>@x.Action</strong><span>@x.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</span><p>@x.OldValue → @x.NewValue</p><small>@x.Reason</small></article>}</div></aside>}</div></section>
<style>
.accounts{display:grid;gap:18px}.account-filter{display:flex;flex-wrap:wrap;gap:10px;padding:16px;background:#fff;border:1px solid #e2e8f0;border-radius:14px}.account-filter input,.account-filter select,.detail select,.detail textarea,.detail input{padding:10px;border:1px solid #cbd5e1;border-radius:8px}.account-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(320px,1fr);gap:18px}.account-panel{overflow:auto;padding:20px;background:#fff;border:1px solid #e2e8f0;border-radius:14px}.account-panel table{width:100%;border-collapse:collapse}.account-panel th,.account-panel td{padding:11px;text-align:left;border-bottom:1px solid #e2e8f0}.account-panel td small{display:block;color:#64748b}.account-panel nav{display:flex;justify-content:center;gap:14px;margin-top:16px}.badge,.permissions span{display:inline-block;padding:5px 9px;border-radius:999px;background:#e0f2fe;color:#0369a1;font-size:11px}.badge.ok{background:#dcfce7;color:#166534}.badge.danger{background:#fee2e2;color:#991b1b}.detail{display:grid;align-content:start;gap:12px}.detail label{display:grid;gap:6px}.permissions{display:flex;flex-wrap:wrap;gap:6px}.danger-button{padding:11px;border:0;border-radius:9px;background:#b91c1c;color:white}.audit{display:grid;gap:9px;max-height:330px;overflow:auto}.audit article{padding:10px;border-left:3px solid #ff5a5f;background:#f8fafc}.audit article span{float:right;font-size:11px;color:#64748b}.audit p{margin:5px 0}.account-error{padding:12px;background:#fef2f2;color:#991b1b;border-radius:9px}@@media(max-width:900px){.account-layout{grid-template-columns:1fr}}
</style>
@code{[Parameter]public Guid? UserId{get;set;}private AdminUserPage _page=new();private AdminUserDetail? _detail;private string _keyword="",_role="",_status="",_verified="",_newRole="Customer",_reason="";private DateTime? _lockUntil;private string? _error;
protected override async Task OnInitializedAsync(){await Load();if(UserId.HasValue)await Select(UserId.Value);}private async Task Load(){try{_error=null;bool? v=bool.TryParse(_verified,out var b)?b:null;_page=await Api.GetAdminUsersAsync(_keyword,_role,_status,v,_page.Page)??new();}catch(Exception e){_error=e.Message;}}private async Task Select(Guid id){try{_detail=await Api.GetAdminUserAsync(id);if(_detail!=null)_newRole=_detail.Role;}catch(Exception e){_error=e.Message;}}private async Task ChangeRole(){if(_detail==null)return;try{_detail=await Api.ChangeUserRoleAsync(_detail.Id,new(){Role=_newRole,Reason=_reason});_reason="";await Load();}catch(Exception e){_error=e.Message;}}private async Task Lock(){if(_detail==null)return;try{_detail=await Api.LockUserAsync(_detail.Id,new(){LockUntil=_lockUntil,Reason=_reason});_reason="";await Load();}catch(Exception e){_error=e.Message;}}private async Task Unlock(){if(_detail==null)return;try{_detail=await Api.UnlockUserAsync(_detail.Id,new(){Reason=_reason});_reason="";await Load();}catch(Exception e){_error=e.Message;}}private async Task Prev(){_page.Page--;await Load();}private async Task Next(){_page.Page++;await Load();}}